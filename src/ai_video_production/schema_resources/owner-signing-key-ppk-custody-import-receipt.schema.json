{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.baisound.local/owner-signing-key-ppk-custody-import-receipt.schema.json",
  "title": "Owner Signing Key PPK Custody Import Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version", "record_type", "task_owner", "receipt_id",
    "ready_sha256", "confirmation_sha256", "custody_receipt_sha256",
    "preflight_sha256", "ppk_file_sha256", "signer_key_id_sha256",
    "owner_scope_sha256", "destination_path_sha256", "imported_at_epoch_ms",
    "state", "ppk_mac_verified", "public_key_rederived",
    "explicit_human_confirmation_received", "custody_import_completed",
    "custody_readback_verified", "private_key_material_included",
    "public_key_material_included", "private_key_export_authorized",
    "signing_authorized", "knowledge_pack_write_authorized",
    "knowledge_pack_promotion_authorized", "runtime_profile_apply_authorized",
    "release_authorized", "deploy_authorized", "production_authorized",
    "external_effect_authorized", "import_receipt_sha256"
  ],
  "properties": {
    "record_version": {"const": "1.0.0"},
    "record_type": {"const": "OWNER_SIGNING_KEY_PPK_CUSTODY_IMPORT_RECEIPT"},
    "task_owner": {"const": "TASK-059"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "ready_sha256": {"$ref": "#/$defs/sha256"},
    "confirmation_sha256": {"$ref": "#/$defs/sha256"},
    "custody_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "ppk_file_sha256": {"$ref": "#/$defs/sha256"},
    "signer_key_id_sha256": {"$ref": "#/$defs/sha256"},
    "owner_scope_sha256": {"$ref": "#/$defs/sha256"},
    "destination_path_sha256": {"$ref": "#/$defs/sha256"},
    "imported_at_epoch_ms": {"type": "integer", "minimum": 1},
    "state": {"const": "CUSTODIED_AND_READBACK_VERIFIED"},
    "ppk_mac_verified": {"const": true},
    "public_key_rederived": {"const": true},
    "explicit_human_confirmation_received": {"const": true},
    "custody_import_completed": {"const": true},
    "custody_readback_verified": {"const": true},
    "private_key_material_included": {"const": false},
    "public_key_material_included": {"const": false},
    "private_key_export_authorized": {"const": false},
    "signing_authorized": {"const": false},
    "knowledge_pack_write_authorized": {"const": false},
    "knowledge_pack_promotion_authorized": {"const": false},
    "runtime_profile_apply_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "import_receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
