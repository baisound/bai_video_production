    "PreactivationFixtureValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "phase",
        "status",
        "evidence_mode",
        "task072_design_sha256",
        "fixture_only",
        "native_broker_executed",
        "operation_id",
        "install_instance_id",
        "record_id",
        "learning_sha256",
        "profile_id",
        "profile_sha256",
        "public_receipt_id",
        "plan_sha256",
        "task036_completion_receipt_sha256",
        "task061b_completion_receipt_sha256",
        "public_receipt_sha256",
        "canonical_readback_sha256",
        "profile_readback_sha256",
        "evidence_binding_sha256",
        "hidden_correlation_fixture_matched",
        "historical_stage_invocation_count",
