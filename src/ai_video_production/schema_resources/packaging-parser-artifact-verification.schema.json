{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.dev/schemas/packaging-parser-artifact-verification.schema.json",
  "title": "TASK-014 Packaging Parser Artifact Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "verifier_id", "verifier_revision", "decision", "reason_codes",
    "distribution_name", "distribution_version", "wheel_filename", "wheel_bytes", "wheel_sha256",
    "metadata_sha256", "source_url", "archive_members", "record_rows", "payload_files",
    "expanded_bytes", "payload_inventory_sha256", "diagnostic_only",
    "official_metadata_observation_accepted", "pin_acceptance_authorized",
    "persistent_receipt_is_capability", "parser_import_authorized", "resolver_use_authorized",
    "install_authorized", "post_return_state_guaranteed", "consumer_revalidation_required",
    "verifier_network_accessed", "verifier_artifact_downloaded", "verifier_package_installed",
    "verifier_parser_imported", "verifier_target_runtime_executed", "verifier_model_loaded",
    "verifier_audio_read", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "bai.task014.packaging-parser-artifact-verification.v1"},
    "verifier_id": {"const": "bai.task014.packaging-parser-artifact-verifier"},
    "verifier_revision": {"const": 1},
    "decision": {"const": "PROPOSED_PACKAGING_ARTIFACT_BYTES_VERIFIED_DIAGNOSTIC"},
    "reason_codes": {"const": []},
    "distribution_name": {"const": "packaging"},
    "distribution_version": {"const": "25.0"},
    "wheel_filename": {"const": "packaging-25.0-py3-none-any.whl"},
    "wheel_bytes": {"const": 66469},
    "wheel_sha256": {"const": "sha256:29572ef2b1f17581046b3a2227d5c611fb25ec70ca1ba8554b24b0e69331a484"},
    "metadata_sha256": {"const": "sha256:5b611a609c38fefc3d616bf45d20aec98fb7d53f245daca9e2c30fc85c7ac282"},
    "source_url": {"const": "https://files.pythonhosted.org/packages/20/12/38679034af332785aac8774540895e234f4d07f7545804097de4b666afd8/packaging-25.0-py3-none-any.whl"},
    "archive_members": {"type": "integer", "minimum": 4, "maximum": 256},
    "record_rows": {"type": "integer", "minimum": 4, "maximum": 256},
    "payload_files": {"type": "integer", "minimum": 3, "maximum": 255},
    "expanded_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "payload_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "diagnostic_only": {"const": true},
    "official_metadata_observation_accepted": {"const": false},
    "pin_acceptance_authorized": {"const": false},
    "persistent_receipt_is_capability": {"const": false},
    "parser_import_authorized": {"const": false},
    "resolver_use_authorized": {"const": false},
    "install_authorized": {"const": false},
    "post_return_state_guaranteed": {"const": false},
    "consumer_revalidation_required": {"const": true},
    "verifier_network_accessed": {"const": false},
    "verifier_artifact_downloaded": {"const": false},
    "verifier_package_installed": {"const": false},
    "verifier_parser_imported": {"const": false},
    "verifier_target_runtime_executed": {"const": false},
    "verifier_model_loaded": {"const": false},
    "verifier_audio_read": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
