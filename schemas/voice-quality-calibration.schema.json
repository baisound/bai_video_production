        "asset_publication_permitted": {"const": false},
        "training_use_permitted": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"contract_state": {"const": "CANONICAL_REF_NOT_PROVIDED"}}}, "then": {"properties": {
          "capture_evidence_binding_ref": {"type": "null"}, "capture_evidence_binding_sha256": {"type": "null"},
          "encrypted_staging_object_ref": {"type": "null"}, "staging_object_sha256": {"type": "null"},
          "canonical_mapping_receipt_ref": {"type": "null"}, "canonical_mapping_receipt_sha256": {"type": "null"},
          "retention_expires_at": {"type": "null"}
        }}},
        {"if": {"properties": {"contract_state": {"const": "BOUND_VERIFIED"}}}, "then": {"properties": {
          "capture_evidence_binding_ref": {"$ref": "#/$defs/id"}, "capture_evidence_binding_sha256": {"$ref": "#/$defs/sha256"},
          "encrypted_staging_object_ref": {"$ref": "#/$defs/id"}, "staging_object_sha256": {"$ref": "#/$defs/sha256"},
          "canonical_mapping_receipt_ref": {"$ref": "#/$defs/id"}, "canonical_mapping_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "retention_expires_at": {"$ref": "#/$defs/timestamp"}
        }}}
      ]
