{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/knowledge-pack-signature-verification-request.schema.json",
  "title": "TASK-029 R8 Knowledge Pack Signature Verification Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version", "record_type", "task_owner", "compatibility_contract",
    "signature_message_contract", "signature_input_contract", "request_id", "signing_candidate_id",
    "signing_candidate_sha256", "pack_id", "pack_version", "predecessor_pack_sha256",
    "trusted_signer_policy_sha256", "signer_key_id_sha256", "signature_algorithm",
    "signature_message_sha256", "state", "owner_scope_coordinates_included",
    "project_scope_coordinates_included", "reviewer_coordinates_included",
    "raw_media_included", "text_body_included", "absolute_host_path_included",
    "credential_included", "signature_bytes_included", "public_key_material_included",
    "private_key_material_included", "key_store_accessed", "signature_present",
    "signature_verified", "latest_source_revalidation_required",
    "external_cryptographic_verification_required", "in_memory_request_only",
    "knowledge_pack_write_authorized", "knowledge_pack_promotion_authorized",
    "automatic_promotion_authorized", "runtime_profile_apply_authorized",
    "rollback_execution_authorized", "release_authorized", "external_effect_authorized",
    "signature_request_sha256"
  ],
  "properties": {
    "request_version": {"const": "1.0.0"},
    "record_type": {"const": "KNOWLEDGE_PACK_SIGNATURE_VERIFICATION_REQUEST"},
    "task_owner": {"const": "TASK-029"},
    "compatibility_contract": {"const": "TASK-029/KNOWLEDGE_PACK/1.0.0"},
    "signature_message_contract": {"const": "TASK-029/KNOWLEDGE_PACK/EXTERNAL_SIGNATURE_MESSAGE/1.0.0"},
    "signature_input_contract": {"const": "TASK-029/KNOWLEDGE_PACK/SIGNATURE_INPUT/SHA256-PREFIXED-ASCII/1.0.0"},
    "request_id": {"$ref": "#/$defs/stableId"},
    "signing_candidate_id": {"$ref": "#/$defs/stableId"},
    "signing_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "pack_id": {"$ref": "#/$defs/stableId"},
    "pack_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "predecessor_pack_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "trusted_signer_policy_sha256": {"$ref": "#/$defs/sha256"},
    "signer_key_id_sha256": {"$ref": "#/$defs/sha256"},
    "signature_algorithm": {"const": "ED25519"},
    "signature_message_sha256": {"$ref": "#/$defs/sha256"},
    "state": {"const": "READY_FOR_EXTERNAL_CRYPTOGRAPHIC_VERIFICATION"},
    "owner_scope_coordinates_included": {"const": false},
    "project_scope_coordinates_included": {"const": false},
    "reviewer_coordinates_included": {"const": false},
    "raw_media_included": {"const": false},
    "text_body_included": {"const": false},
    "absolute_host_path_included": {"const": false},
    "credential_included": {"const": false},
    "signature_bytes_included": {"const": false},
    "public_key_material_included": {"const": false},
    "private_key_material_included": {"const": false},
    "key_store_accessed": {"const": false},
    "signature_present": {"const": false},
    "signature_verified": {"const": false},
    "latest_source_revalidation_required": {"const": true},
    "external_cryptographic_verification_required": {"const": true},
    "in_memory_request_only": {"const": true},
    "knowledge_pack_write_authorized": {"const": false},
    "knowledge_pack_promotion_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "runtime_profile_apply_authorized": {"const": false},
    "rollback_execution_authorized": {"const": false},
    "release_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "signature_request_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"}
  }
}
