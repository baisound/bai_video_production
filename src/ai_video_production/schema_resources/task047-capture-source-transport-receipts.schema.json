{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bvp.task047.capture-source-transport-receipts.v1",
  "title": "TASK-047 body-free capture source and transport receipts",
  "oneOf": [
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/transport"
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": [
        "record_type",
        "schema_version",
        "project_id",
        "recording_session_id",
        "segment_attempt_id",
        "operation_id",
        "idempotency_key",
        "owner_subject_binding_sha256",
        "consent_evaluation_sha256",
        "producer_code_sha256",
        "runtime_sha256",
        "trusted_time_binding_sha256",
        "capture_job_id",
        "capture_job_revision_sha256",
        "capture_job_predecessor_readback_sha256",
        "created_at",
        "observed_at",
        "fresh_until",
        "predecessor_receipt_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "record_type": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}(?![\\s\\S])"
        },
        "recording_session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}(?![\\s\\S])"
        },
        "segment_attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}(?![\\s\\S])"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}(?![\\s\\S])"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}(?![\\s\\S])"
        },
        "owner_subject_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "consent_evaluation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "producer_code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "trusted_time_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "capture_job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}(?![\\s\\S])"
        },
        "capture_job_revision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "capture_job_predecessor_readback_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z(?![\\s\\S])"
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z(?![\\s\\S])"
        },
        "fresh_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z(?![\\s\\S])"
        },
        "predecessor_receipt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "source": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "record_type",
            "schema_version",
            "predecessor_receipt_sha256",
            "source_binding_sha256",
            "obs_build_sha256",
            "obs_process_identity_sha256",
            "source_graph_sha256",
            "source_sample_format",
            "source_sample_rate_hz",
            "source_channel_count",
            "measurement_point",
            "source_classification",
            "source_currentness_state"
          ],
          "properties": {
            "record_type": {
              "const": "CaptureSourceCurrentnessReceiptV1"
            },
            "schema_version": {
              "const": 1
            },
            "predecessor_receipt_sha256": {
              "type": "null"
            },
            "source_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "obs_build_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "obs_process_identity_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "source_graph_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "source_sample_format": {
              "const": "FLOAT32_PLANAR"
            },
            "source_sample_rate_hz": {
              "type": "integer",
              "minimum": 8000,
              "maximum": 384000
            },
            "source_channel_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "measurement_point": {
              "enum": [
                "PRE_FILTER",
                "POST_FILTER"
              ]
            },
            "source_classification": {
              "enum": [
                "OWNER_SELECTED_ISOLATED_MIC",
                "MIXED_OR_NON_MIC",
                "UNKNOWN"
              ]
            },
            "source_currentness_state": {
              "enum": [
                "BOUND_VERIFIED",
                "MISMATCH",
                "STALE",
                "REVOKED",
                "UNKNOWN"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "transport": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "record_type",
            "schema_version",
            "predecessor_receipt_sha256",
            "source_receipt_sha256",
            "hmac_key_epoch_sha256",
            "first_packet_sequence",
            "last_packet_sequence",
            "observed_packet_count",
            "accepted_packet_count",
            "source_frame_count",
            "source_sample_count",
            "first_source_timestamp_ns",
            "last_source_timestamp_ns",
            "gap_count",
            "duplicate_count",
            "reorder_count",
            "overrun_count",
            "reconnect_count",
            "nonfinite_sample_count",
            "transport_verification_state"
          ],
          "properties": {
            "record_type": {
              "const": "CaptureTransportIntegrityReceiptV2"
            },
            "schema_version": {
              "const": 2
            },
            "predecessor_receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "source_receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "hmac_key_epoch_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "first_packet_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "last_packet_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observed_packet_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "accepted_packet_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source_frame_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source_sample_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "first_source_timestamp_ns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "last_source_timestamp_ns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "gap_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "duplicate_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reorder_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "overrun_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reconnect_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "nonfinite_sample_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "transport_verification_state": {
              "enum": [
                "BOUND_VERIFIED",
                "MISMATCH",
                "UNKNOWN"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
