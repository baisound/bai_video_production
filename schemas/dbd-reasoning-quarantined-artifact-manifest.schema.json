{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.local/schemas/dbd-reasoning-quarantined-artifact-manifest.schema.json",
  "title": "DbD Reasoning Quarantined Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_kind", "artifact_manifest_id", "quarantine_ref",
    "base_model_ref", "base_model_sha256", "adapter_ref", "adapter_sha256",
    "files", "total_bytes", "training_dataset_sha256", "training_recipe_sha256",
    "evaluation_report_sha256", "rights_manifest_sha256", "test_sample_set_sha256",
    "tuned_binding_sha256", "sealed_at", "state", "artifact_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "DBD_REASONING_QUARANTINED_ARTIFACT_MANIFEST"},
    "artifact_manifest_id": {"type": "string", "pattern": "^ART-[0-9A-HJKMNP-TV-Z]{26}$"},
    "quarantine_ref": {"type": "string", "pattern": "^model-quarantine://task054/[0-9A-HJKMNP-TV-Z]{26}$"},
    "base_model_ref": {"type": "string", "pattern": "^model://registry/[A-Za-z0-9][A-Za-z0-9._/-]{0,95}$"},
    "base_model_sha256": {"$ref": "#/$defs/sha"},
    "adapter_ref": {"type": "string", "pattern": "^model-adapter://registry/[A-Za-z0-9][A-Za-z0-9._/-]{0,95}$"},
    "adapter_sha256": {"$ref": "#/$defs/sha"},
    "files": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/file"}},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "training_dataset_sha256": {"$ref": "#/$defs/sha"},
    "training_recipe_sha256": {"$ref": "#/$defs/sha"},
    "evaluation_report_sha256": {"$ref": "#/$defs/sha"},
    "rights_manifest_sha256": {"$ref": "#/$defs/sha"},
    "test_sample_set_sha256": {"$ref": "#/$defs/sha"},
    "tuned_binding_sha256": {"$ref": "#/$defs/sha"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "state": {"const": "QUARANTINED_EVALUATED_NO_APPROVAL_OR_ACTIVATION"},
    "artifact_manifest_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_path", "role", "size_bytes", "content_sha256"],
      "properties": {
        "logical_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}$"},
        "role": {"enum": ["ADAPTER", "CONFIG", "TOKENIZER", "METADATA", "OTHER"]},
        "size_bytes": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
