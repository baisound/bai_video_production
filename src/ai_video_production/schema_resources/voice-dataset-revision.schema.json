        "exclusion_sha256s": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "policy_revision_sha256": {"$ref": "#/$defs/sha256"},
        "readiness_sha256": {"$ref": "#/$defs/sha256"},
        "current_consent_evaluation_sha256": {"$ref": "#/$defs/sha256"},
