{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/knowledge-pack-promotion-candidate.schema.json",
  "title": "TASK-029 R6 Knowledge Pack Promotion Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version", "record_type", "task_owner", "candidate_id", "feature_rule",
    "feature_rule_sha256", "hypothesis_id", "action_type", "condition_fingerprint_sha256",
    "source_coordinate_sha256s", "source_owner_count", "source_project_count",
    "source_evidence_count", "aggregated_metric_evaluations",
    "minimum_owner_weighted_benefit_milli", "promotion_policy", "state",
    "owner_scope_coordinates_included", "project_scope_coordinates_included",
    "raw_media_included", "text_body_included", "absolute_host_path_included",
    "credential_included", "latest_source_revalidation_required", "human_review_required",
    "independent_critic_required", "signature_required", "in_memory_candidate_only",
    "knowledge_pack_write_authorized", "knowledge_pack_promotion_authorized",
    "automatic_promotion_authorized", "runtime_profile_apply_authorized",
    "rollback_execution_authorized", "release_authorized", "external_effect_authorized",
    "candidate_sha256"
  ],
  "properties": {
    "candidate_version": {"const": "1.0.0"},
    "record_type": {"const": "KNOWLEDGE_PACK_PROMOTION_CANDIDATE"},
    "task_owner": {"const": "TASK-029"},
    "candidate_id": {"$ref": "#/$defs/stableId"},
    "feature_rule": {"$ref": "#/$defs/featureRule"},
    "feature_rule_sha256": {"$ref": "#/$defs/sha256"},
    "hypothesis_id": {"$ref": "#/$defs/stableId"},
    "action_type": {"$ref": "#/$defs/stableId"},
    "condition_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "source_coordinate_sha256s": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "source_owner_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "source_project_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "source_evidence_count": {"type": "integer", "minimum": 1, "maximum": 16384},
    "aggregated_metric_evaluations": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/metric"}
    },
    "minimum_owner_weighted_benefit_milli": {"type": "integer", "minimum": -1000, "maximum": 1000},
    "promotion_policy": {"$ref": "#/$defs/policy"},
    "state": {
      "enum": [
        "READY_FOR_HUMAN_KNOWLEDGE_PACK_REVIEW", "INSUFFICIENT_OWNER_DIVERSITY",
        "INSUFFICIENT_PROJECT_DIVERSITY", "INSUFFICIENT_SAMPLES", "AXIS_REGRESSION",
        "NO_REPRODUCIBLE_BENEFIT"
      ]
    },
    "owner_scope_coordinates_included": {"const": false},
    "project_scope_coordinates_included": {"const": false},
    "raw_media_included": {"const": false},
    "text_body_included": {"const": false},
    "absolute_host_path_included": {"const": false},
    "credential_included": {"const": false},
    "latest_source_revalidation_required": {"const": true},
    "human_review_required": {"const": true},
    "independent_critic_required": {"const": true},
    "signature_required": {"const": true},
    "in_memory_candidate_only": {"const": true},
    "knowledge_pack_write_authorized": {"const": false},
    "knowledge_pack_promotion_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "runtime_profile_apply_authorized": {"const": false},
    "rollback_execution_authorized": {"const": false},
    "release_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"},
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_task_id", "contract_id"],
      "properties": {
        "producer_task_id": {"type": "string", "pattern": "^TASK-[0-9]{3}$"},
        "contract_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "featureRule": {
      "type": "object", "additionalProperties": false,
      "required": [
        "feature_key", "modality", "weight_milli", "raw_range", "polarity",
        "required", "optional_missing_value_milli", "allowed_sources"
      ],
      "properties": {
        "feature_key": {"$ref": "#/$defs/stableId"},
        "modality": {"enum": ["AUDIO", "VISUAL", "TEXT", "TEMPORAL", "SEMANTIC"]},
        "weight_milli": {"type": "integer", "minimum": 1, "maximum": 1000},
        "raw_range": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": -1000000000, "maximum": 1000000000},
            "maximum": {"type": "integer", "minimum": -1000000000, "maximum": 1000000000}
          }
        },
        "polarity": {"enum": ["DIRECT", "INVERSE"]},
        "required": {"type": "boolean"},
        "optional_missing_value_milli": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000},
        "allowed_sources": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/selector"}
        }
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "minimum_delta_milli", "total_sample_count", "contributing_owner_count"],
      "properties": {
        "metric_id": {
          "enum": ["human_acceptance", "qa_compliance", "quality_improvement", "rework_reduction", "sample_confidence", "time_reduction"]
        },
        "minimum_delta_milli": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "total_sample_count": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "contributing_owner_count": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "policy_id", "policy_version", "minimum_owner_count", "minimum_project_count",
        "minimum_samples_per_axis", "minimum_owner_weighted_benefit_milli",
        "maximum_axis_regression_milli", "policy_sha256"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/stableId"},
        "policy_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "minimum_owner_count": {"type": "integer", "minimum": 2, "maximum": 64},
        "minimum_project_count": {"type": "integer", "minimum": 2, "maximum": 4096},
        "minimum_samples_per_axis": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "minimum_owner_weighted_benefit_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "maximum_axis_regression_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
