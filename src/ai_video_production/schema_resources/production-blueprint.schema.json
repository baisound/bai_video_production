{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baisound/bai_video_production/schemas/production-blueprint.schema.json",
  "title": "BAI Production Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueprint_version", "blueprint_id", "title", "timeline_rate", "target_duration_frames", "asset_source_priority", "references", "scenes", "blueprint_sha256"],
  "properties": {
    "blueprint_version": {"const": "1.0.0"},
    "blueprint_id": {"type": "string", "pattern": "^BP-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "timeline_rate": {"$ref": "#/$defs/frameRate"},
    "target_duration_frames": {"type": "integer", "minimum": 1},
    "asset_source_priority": {"const": ["REAL_CAPTURE", "REUSE_EXISTING", "COMPOSITE", "AI_GENERATED"]},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "blueprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "frameRate": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "kind", "status", "filename"],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*([-_][A-Z0-9]+){1,7}$"},
        "kind": {"enum": ["PERSON", "SPACE", "PROMPT", "ASSET", "AUDIO"]},
        "status": {"enum": ["AVAILABLE", "PLANNED", "LOCKED"]},
        "filename": {"type": ["string", "null"]}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_id", "range_frames", "narrative_role", "source_strategy", "generation_risk", "camera_motion", "reference_ids", "audio", "locked_reference", "post_composite_text", "final_hold_frames"],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^SC[0-9]{2,3}(-[A-Z])?$"},
        "range_frames": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end_exclusive"],
          "properties": {"start": {"type": "integer", "minimum": 0}, "end_exclusive": {"type": "integer", "minimum": 1}}
        },
        "narrative_role": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_strategy": {"enum": ["REAL_CAPTURE", "REUSE_EXISTING", "COMPOSITE", "AI_GENERATED"]},
        "generation_risk": {"enum": ["A_LOW_TEXT", "B_HEADLINE", "C_DENSE_UI"]},
        "camera_motion": {"enum": ["STATIC", "SUBTLE", "DYNAMIC"]},
        "reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "audio": {
          "type": "object", "additionalProperties": false,
          "required": ["narration", "dialogue", "sound_effects", "bgm", "sound_logo"],
          "properties": {
            "narration": {"type": "boolean"}, "dialogue": {"type": "boolean"},
            "sound_effects": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
            "bgm": {"type": "boolean"}, "sound_logo": {"type": "boolean"}
          }
        },
        "locked_reference": {"type": "boolean"},
        "post_composite_text": {"type": "boolean"},
        "final_hold_frames": {"type": "integer", "minimum": 0}
      }
    }
  }
}
