        "reverification_state", "dataset_adoption_permitted", "asset_publication_permitted",
        "training_use_permitted"
      ],
      "properties": {
        "contract_state": {"$ref": "#/$defs/contractState"},
        "capture_evidence_binding_ref": {"$ref": "#/$defs/nullableId"},
        "capture_evidence_binding_sha256": {"$ref": "#/$defs/nullableSha256"},
        "encrypted_staging_object_ref": {"$ref": "#/$defs/nullableId"},
        "staging_object_sha256": {"$ref": "#/$defs/nullableSha256"},
        "canonical_mapping_receipt_ref": {"$ref": "#/$defs/nullableId"},
        "canonical_mapping_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
