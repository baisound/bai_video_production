{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/profile-tuning-proposal.schema.json",
  "title": "TASK-019 Profile Tuning Proposal",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "producer_task_id": { "type": "string", "pattern": "^TASK-[0-9]{3}$" },
        "contract_id": { "$ref": "#/$defs/stableId" }
      },
      "required": ["producer_task_id", "contract_id"]
    },
    "featureRule": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "feature_key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){0,7}$" },
        "modality": { "enum": ["AUDIO", "VISUAL", "LANGUAGE_TEXT", "OCR_TEXT"] },
        "weight_milli": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "raw_range": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "minimum": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 },
            "maximum": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 }
          },
          "required": ["minimum", "maximum"]
        },
        "polarity": { "enum": ["DIRECT", "INVERSE"] },
        "required": { "type": "boolean" },
        "optional_missing_value_milli": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 },
        "allowed_sources": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/selector" } }
      },
      "required": [
        "feature_key", "modality", "weight_milli", "raw_range", "polarity", "required",
        "optional_missing_value_milli", "allowed_sources"
      ]
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "profile_id": { "$ref": "#/$defs/stableId" },
        "profile_version": { "$ref": "#/$defs/semver" },
        "rules": { "type": "array", "minItems": 2, "maxItems": 128, "items": { "$ref": "#/$defs/featureRule" } },
        "profile_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["profile_id", "profile_version", "rules", "profile_sha256"]
    },
    "adjustment": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "feature_key": { "$ref": "#/$defs/stableId" },
        "proposed_weight_milli": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "reason": { "enum": ["ENGAGEMENT_SIGNAL", "RETENTION_SIGNAL", "FEATURE_BALANCE"] }
      },
      "required": ["feature_key", "proposed_weight_milli", "reason"]
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "evaluation_id": { "$ref": "#/$defs/stableId" },
        "holdout_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "sample_count": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "baseline_quality_milli": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "proposed_quality_milli": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "delta_milli": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "validity": { "enum": ["CURRENT_VALID", "STALE", "REVOKED", "UNKNOWN"] }
      },
      "required": [
        "evaluation_id", "holdout_manifest_sha256", "sample_count", "baseline_quality_milli",
        "proposed_quality_milli", "delta_milli", "validity"
      ]
    }
  },
  "properties": {
    "proposal_version": { "const": "1.0.0" },
    "task_owner": { "const": "TASK-019" },
    "baseline_profile": { "$ref": "#/$defs/profile" },
    "proposed_profile": { "$ref": "#/$defs/profile" },
    "feedback_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "feedback_state": { "enum": ["COMPLETE", "PARTIAL_REQUIRED_METRICS", "UNKNOWN_EVIDENCE", "STALE_OR_REVOKED_EVIDENCE"] },
    "tuning_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "policy_id": { "$ref": "#/$defs/stableId" },
        "policy_version": { "$ref": "#/$defs/semver" },
        "max_changed_rules": { "type": "integer", "minimum": 2, "maximum": 16 },
        "max_abs_weight_delta_milli": { "type": "integer", "minimum": 1, "maximum": 500 },
        "minimum_holdout_samples": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "minimum_improvement_milli": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_single_holdout_regression_milli": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "policy_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": [
        "policy_id", "policy_version", "max_changed_rules", "max_abs_weight_delta_milli",
        "minimum_holdout_samples", "minimum_improvement_milli",
        "max_single_holdout_regression_milli", "policy_sha256"
      ]
    },
    "adjustments": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/adjustment" } },
    "holdout_evaluations": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/evaluation" } },
    "state": {
      "enum": [
        "READY_FOR_HUMAN_REVIEW", "FEEDBACK_INCOMPLETE", "INSUFFICIENT_HOLDOUT",
        "NO_MEASURED_IMPROVEMENT", "HOLDOUT_REGRESSION", "UNKNOWN_EVIDENCE",
        "STALE_OR_REVOKED_EVIDENCE"
      ]
    },
    "total_holdout_samples": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "weighted_improvement_milli": { "type": ["integer", "null"], "minimum": -1000, "maximum": 1000 },
    "regressed_evaluation_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "rollback_profile_sha256": { "$ref": "#/$defs/sha256" },
    "human_review_required": { "const": true },
    "automatic_profile_write_authorized": { "const": false },
    "automatic_promotion_authorized": { "const": false },
    "automatic_rollback_execution_authorized": { "const": false },
    "edit_plan_mutation_authorized": { "const": false },
    "external_effect_authorized": { "const": false },
    "proposal_sha256": { "$ref": "#/$defs/sha256" }
  },
  "required": [
    "proposal_version", "task_owner", "baseline_profile", "proposed_profile",
    "feedback_snapshot_sha256", "feedback_state", "tuning_policy", "adjustments",
    "holdout_evaluations", "state", "total_holdout_samples", "weighted_improvement_milli",
    "regressed_evaluation_ids", "rollback_profile_sha256", "human_review_required",
    "automatic_profile_write_authorized", "automatic_promotion_authorized",
    "automatic_rollback_execution_authorized", "edit_plan_mutation_authorized",
    "external_effect_authorized", "proposal_sha256"
  ]
}
