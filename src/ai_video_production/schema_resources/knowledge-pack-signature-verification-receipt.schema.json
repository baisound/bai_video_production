{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/knowledge-pack-signature-verification-receipt.schema.json",
  "title": "TASK-029 R9A Knowledge Pack Signature Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version", "record_type", "task_owner", "receipt_id",
    "signature_request_id", "signature_request_sha256", "signing_candidate_sha256",
    "pack_id", "pack_version", "trusted_signer_policy_sha256",
    "signer_key_id_sha256", "signature_algorithm", "signature_input_contract",
    "signature_message_sha256", "detached_signature_sha256", "state",
    "signature_present", "signature_verified", "latest_source_revalidated",
    "signature_bytes_included",
    "public_key_material_included", "private_key_material_included",
    "knowledge_pack_write_authorized", "knowledge_pack_promotion_authorized",
    "automatic_promotion_authorized", "runtime_profile_apply_authorized",
    "rollback_execution_authorized", "release_authorized", "external_effect_authorized",
    "verification_receipt_sha256"
  ],
  "properties": {
    "receipt_version": {"const": "1.0.0"},
    "record_type": {"const": "KNOWLEDGE_PACK_SIGNATURE_VERIFICATION_RECEIPT"},
    "task_owner": {"const": "TASK-029"},
    "receipt_id": {"$ref": "#/$defs/stableId"},
    "signature_request_id": {"$ref": "#/$defs/stableId"},
    "signature_request_sha256": {"$ref": "#/$defs/sha256"},
    "signing_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "pack_id": {"$ref": "#/$defs/stableId"},
    "pack_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "trusted_signer_policy_sha256": {"$ref": "#/$defs/sha256"},
    "signer_key_id_sha256": {"$ref": "#/$defs/sha256"},
    "signature_algorithm": {"const": "ED25519"},
    "signature_input_contract": {"const": "TASK-029/KNOWLEDGE_PACK/SIGNATURE_INPUT/SHA256-PREFIXED-ASCII/1.0.0"},
    "signature_message_sha256": {"$ref": "#/$defs/sha256"},
    "detached_signature_sha256": {"$ref": "#/$defs/sha256"},
    "state": {"const": "VERIFIED"},
    "signature_present": {"const": true},
    "signature_verified": {"const": true},
    "latest_source_revalidated": {"const": true},
    "signature_bytes_included": {"const": false},
    "public_key_material_included": {"const": false},
    "private_key_material_included": {"const": false},
    "knowledge_pack_write_authorized": {"const": false},
    "knowledge_pack_promotion_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "runtime_profile_apply_authorized": {"const": false},
    "rollback_execution_authorized": {"const": false},
    "release_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "verification_receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"}
  }
}
