{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","record_kind","segment_id","rights_candidate_id","rights_manifest_sha256","match_id","event_ids","context_sha256","source_video_ref","source_audio_ref","source_start_us","source_end_us_exclusive","speaker_ref","asr_revision","asr_sha256","diarization_revision","diarization_sha256","original_transcript_sha256","corrected_transcript_sha256","redacted_transcript","role","patch_version","human_review_ref","human_review_sha256","issue_codes","disposition","intake_state","intake_sha256"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"record_kind":{"const":"DBD_REASONING_NARRATION_INTAKE_CANDIDATE"},
    "segment_id":{"type":"string","pattern":"^SEG-[0-9A-HJKMNP-TV-Z]{26}$"},"rights_candidate_id":{"type":"string","pattern":"^CAND-R2D[0-9A-HJKMNP-TV-Z]{23}$"},
    "rights_manifest_sha256":{"$ref":"#/$defs/sha"},"match_id":{"type":"string","pattern":"^MATCH-[0-9A-HJKMNP-TV-Z]{26}$"},
    "event_ids":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"type":"string","pattern":"^GEVT-[0-9A-HJKMNP-TV-Z]{26}$"}},
    "context_sha256":{"$ref":"#/$defs/sha"},"source_video_ref":{"$ref":"#/$defs/media"},"source_audio_ref":{"$ref":"#/$defs/media"},
    "source_start_us":{"type":"integer","minimum":0},"source_end_us_exclusive":{"type":"integer","minimum":1},
    "speaker_ref":{"type":"string","pattern":"^speaker://sha256/[0-9a-f]{64}$"},"asr_revision":{"type":"integer","minimum":1},"asr_sha256":{"$ref":"#/$defs/sha"},
    "diarization_revision":{"type":"integer","minimum":1},"diarization_sha256":{"$ref":"#/$defs/sha"},
    "original_transcript_sha256":{"$ref":"#/$defs/sha"},"corrected_transcript_sha256":{"$ref":"#/$defs/sha"},
    "redacted_transcript":{"type":"string","minLength":1,"maxLength":4000},
    "role":{"enum":["PLAY_BY_PLAY","ANALYSIS","TACTICAL","REACTION","TRANSITION","FILLER","UNCERTAIN"]},
    "patch_version":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},"human_review_ref":{"type":"string","pattern":"^human-review://sha256/[0-9a-f]{64}$"},
    "human_review_sha256":{"$ref":"#/$defs/sha"},"issue_codes":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._+-]{0,63}$"}},
    "disposition":{"enum":["ELIGIBLE_CANDIDATE","NEEDS_REVIEW","REJECTED"]},"intake_state":{"const":"CANDIDATE_ONLY_NO_ADOPTION"},"intake_sha256":{"$ref":"#/$defs/sha"}
  },"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"media":{"type":"string","pattern":"^media://sha256/[0-9a-f]{64}$"}}
}
