{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.local/schemas/task102-project-manifest-transaction.schema.json",
  "title": "TASK-102 Project Manifest Secure Transaction V1",
  "oneOf": [
    { "$ref": "#/$defs/Intent" },
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/PhaseResult" },
    { "$ref": "#/$defs/Enrollment" },
    { "$ref": "#/$defs/ParticipantPlan" },
    { "$ref": "#/$defs/ParticipantReceipt" },
    { "$ref": "#/$defs/ProfileValidationReceipt" },
    { "$ref": "#/$defs/Journal" },
    { "$ref": "#/$defs/Witness" },
    { "$ref": "#/$defs/PublicStatus" }
  ],
  "$defs": {
    "Sha": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "NullableSha": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Sha" }] },
    "Id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "Ref": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:/{0,2})[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
    "NullableRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Ref" }] },
    "Time": { "type": "string", "pattern": "^(?:(?:(?!0000)[0-9]{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00))-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$" },
    "ShaArray": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/Sha" } },
    "OperationKind": { "enum": ["MANIFEST_CREATE_V1", "MANIFEST_TRANSITION_V1", "CONTROL_OBJECT_CAS_V1", "CONTROL_APPEND_CHAIN_V1", "CONTROL_RECOVERY_OBJECT_V1", "CONTROL_SNAPSHOT_SET_V1", "PROJECT_READ_LEASE_V1", "QUERY_OPERATION_V1"] },
    "FailureClass": { "enum": ["IO_FAILURE", "CORRUPT_RECORD", "DIGEST_MISMATCH", "AUTHENTICITY_UNPROVEN", "SECURITY_BINDING_DRIFT", "AMBIGUOUS_DUPLICATE"] },
    "CanonicalDocument": { "type": "object" },
    "ManifestCreatePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["successor_manifest", "successor_manifest_sha256", "semantic_authorization_sha256"],
      "properties": { "successor_manifest": { "$ref": "#/$defs/CanonicalDocument" }, "successor_manifest_sha256": { "$ref": "#/$defs/Sha" }, "semantic_authorization_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ManifestTransitionPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_manifest_sha256", "prior_manifest_physical_identity_ref", "successor_manifest", "successor_manifest_sha256", "participant_plan_sha256", "semantic_authorization_sha256"],
      "properties": { "prior_manifest_sha256": { "$ref": "#/$defs/Sha" }, "prior_manifest_physical_identity_ref": { "$ref": "#/$defs/Ref" }, "successor_manifest": { "$ref": "#/$defs/CanonicalDocument" }, "successor_manifest_sha256": { "$ref": "#/$defs/Sha" }, "participant_plan_sha256": { "$ref": "#/$defs/Sha" }, "semantic_authorization_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ControlCasPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["predecessor_sha256", "predecessor_physical_identity_ref", "successor_document", "successor_sha256", "semantic_authorization_sha256"],
      "properties": { "predecessor_sha256": { "$ref": "#/$defs/Sha" }, "predecessor_physical_identity_ref": { "$ref": "#/$defs/Ref" }, "successor_document": { "$ref": "#/$defs/CanonicalDocument" }, "successor_sha256": { "$ref": "#/$defs/Sha" }, "semantic_authorization_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ControlAppendPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_terminal_revision", "prior_terminal_sha256", "successor_document", "successor_sha256", "semantic_authorization_sha256"],
      "properties": { "prior_terminal_revision": { "type": "integer", "minimum": 1 }, "prior_terminal_sha256": { "$ref": "#/$defs/Sha" }, "successor_document": { "$ref": "#/$defs/CanonicalDocument" }, "successor_sha256": { "$ref": "#/$defs/Sha" }, "semantic_authorization_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ControlRecoveryPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["recovery_action", "predecessor_sha256", "successor_document", "successor_sha256", "terminal_proof_sha256", "semantic_authorization_sha256"],
      "properties": { "recovery_action": { "$ref": "#/$defs/Id" }, "predecessor_sha256": { "$ref": "#/$defs/Sha" }, "successor_document": { "$ref": "#/$defs/CanonicalDocument" }, "successor_sha256": { "$ref": "#/$defs/Sha" }, "terminal_proof_sha256": { "$ref": "#/$defs/Sha" }, "semantic_authorization_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ControlSnapshotPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["create_set", "retain_set", "remove_set", "retention_policy_sha256", "semantic_authorization_sha256"],
      "properties": { "create_set": { "$ref": "#/$defs/ShaArray" }, "retain_set": { "$ref": "#/$defs/ShaArray" }, "remove_set": { "$ref": "#/$defs/ShaArray" }, "retention_policy_sha256": { "$ref": "#/$defs/Sha" }, "semantic_authorization_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ReadLeasePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_manifest_sha256", "expected_state_coordinate_sha256", "observation_profile_id"],
      "properties": { "expected_manifest_sha256": { "$ref": "#/$defs/Sha" }, "expected_state_coordinate_sha256": { "$ref": "#/$defs/Sha" }, "observation_profile_id": { "$ref": "#/$defs/Id" } }
    },
    "QueryPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["queried_operation_id", "queried_intent_sha256", "queried_request_sha256"],
      "properties": { "queried_operation_id": { "$ref": "#/$defs/Id" }, "queried_intent_sha256": { "$ref": "#/$defs/Sha" }, "queried_request_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "IntentPayload": { "oneOf": [{ "$ref": "#/$defs/ManifestCreatePayload" }, { "$ref": "#/$defs/ManifestTransitionPayload" }, { "$ref": "#/$defs/ControlCasPayload" }, { "$ref": "#/$defs/ControlAppendPayload" }, { "$ref": "#/$defs/ControlRecoveryPayload" }, { "$ref": "#/$defs/ControlSnapshotPayload" }, { "$ref": "#/$defs/ReadLeasePayload" }, { "$ref": "#/$defs/QueryPayload" }] },
    "Intent": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_version", "record_type", "project_registration_id", "operation_id", "operation_kind", "operation_profile_id", "caller_task_id", "caller_build_sha256", "caller_policy_sha256", "requested_at", "expires_at", "payload", "intent_sha256"],
      "properties": { "protocol_version": { "const": "PMST_V1" }, "record_type": { "const": "PMST_OPERATION_INTENT_V1" }, "project_registration_id": { "$ref": "#/$defs/Id" }, "operation_id": { "$ref": "#/$defs/Id" }, "operation_kind": { "$ref": "#/$defs/OperationKind" }, "operation_profile_id": { "$ref": "#/$defs/Id" }, "caller_task_id": { "$ref": "#/$defs/Id" }, "caller_build_sha256": { "$ref": "#/$defs/Sha" }, "caller_policy_sha256": { "$ref": "#/$defs/Sha" }, "requested_at": { "$ref": "#/$defs/Time" }, "expires_at": { "$ref": "#/$defs/Time" }, "payload": { "$ref": "#/$defs/IntentPayload" }, "intent_sha256": { "$ref": "#/$defs/Sha" } },
      "allOf": [
        { "if": { "properties": { "operation_kind": { "const": "MANIFEST_CREATE_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ManifestCreatePayload" } } } },
        { "if": { "properties": { "operation_kind": { "const": "MANIFEST_TRANSITION_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ManifestTransitionPayload" } } } },
        { "if": { "properties": { "operation_kind": { "const": "CONTROL_OBJECT_CAS_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ControlCasPayload" } } } },
        { "if": { "properties": { "operation_kind": { "const": "CONTROL_APPEND_CHAIN_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ControlAppendPayload" } } } },
        { "if": { "properties": { "operation_kind": { "const": "CONTROL_RECOVERY_OBJECT_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ControlRecoveryPayload" } } } },
        { "if": { "properties": { "operation_kind": { "const": "CONTROL_SNAPSHOT_SET_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ControlSnapshotPayload" } } } },
        { "if": { "properties": { "operation_kind": { "const": "PROJECT_READ_LEASE_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ReadLeasePayload" } } } },
        { "if": { "properties": { "operation_kind": { "const": "QUERY_OPERATION_V1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/QueryPayload" } } } }
      ]
    },
    "Request": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_version", "record_type", "broker_instance_id", "session_id", "request_nonce_id", "intent", "request_sha256"],
      "properties": { "protocol_version": { "const": "PMST_V1" }, "record_type": { "const": "PMST_PRIVATE_REQUEST_V1" }, "broker_instance_id": { "$ref": "#/$defs/Id" }, "session_id": { "$ref": "#/$defs/Id" }, "request_nonce_id": { "$ref": "#/$defs/Id" }, "intent": { "$ref": "#/$defs/Intent" }, "request_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "Enrollment": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "protocol_version", "project_registration_id", "project_id", "root_physical_identity_ref", "control_physical_identity_ref", "manifest_physical_identity_ref", "volume_binding_sha256", "owner_dacl_binding_sha256", "writer_migration_matrix_sha256", "broker_install_binding_sha256", "enrollment_epoch", "created_at", "status", "enrollment_sha256"],
      "properties": { "record_type": { "const": "PMST_ENROLLMENT_V1" }, "protocol_version": { "const": "PMST_V1" }, "project_registration_id": { "$ref": "#/$defs/Id" }, "project_id": { "$ref": "#/$defs/Id" }, "root_physical_identity_ref": { "$ref": "#/$defs/Ref" }, "control_physical_identity_ref": { "$ref": "#/$defs/Ref" }, "manifest_physical_identity_ref": { "$ref": "#/$defs/Ref" }, "volume_binding_sha256": { "$ref": "#/$defs/Sha" }, "owner_dacl_binding_sha256": { "$ref": "#/$defs/Sha" }, "writer_migration_matrix_sha256": { "$ref": "#/$defs/Sha" }, "broker_install_binding_sha256": { "$ref": "#/$defs/Sha" }, "enrollment_epoch": { "$ref": "#/$defs/Id" }, "created_at": { "$ref": "#/$defs/Time" }, "status": { "enum": ["PREPARED", "ACTIVE", "SUSPENDED", "REVOKED"] }, "enrollment_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ParticipantPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "protocol_version", "operation_id", "participant_id", "participant_profile_id", "semantic_owner_task_id", "object_commitments", "prepare_supported", "commit_supported", "reconcile_supported", "abort_before_commit_supported", "plan_sha256"],
      "properties": { "record_type": { "const": "PMST_PARTICIPANT_PLAN_V1" }, "protocol_version": { "const": "PMST_V1" }, "operation_id": { "$ref": "#/$defs/Id" }, "participant_id": { "$ref": "#/$defs/Id" }, "participant_profile_id": { "$ref": "#/$defs/Id" }, "semantic_owner_task_id": { "$ref": "#/$defs/Id" }, "object_commitments": { "$ref": "#/$defs/ShaArray" }, "prepare_supported": { "const": true }, "commit_supported": { "type": "boolean" }, "reconcile_supported": { "const": true }, "abort_before_commit_supported": { "type": "boolean" }, "plan_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "ParticipantReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "protocol_version", "operation_id", "participant_id", "plan_sha256", "participant_phase", "participant_status", "object_observations", "effect_observation", "receipt_sequence", "receipt_sha256"],
      "properties": { "record_type": { "const": "PMST_PARTICIPANT_RECEIPT_V1" }, "protocol_version": { "const": "PMST_V1" }, "operation_id": { "$ref": "#/$defs/Id" }, "participant_id": { "$ref": "#/$defs/Id" }, "plan_sha256": { "$ref": "#/$defs/Sha" }, "participant_phase": { "enum": ["PREPARE", "COMMIT", "RECONCILE", "ABORT"] }, "participant_status": { "enum": ["PREPARED_NO_COMMIT", "PREPARE_BLOCKED_NO_EFFECT", "PREPARE_OUTCOME_UNKNOWN", "OBJECTS_COMMITTED", "OBJECTS_NOT_COMMITTED_PROVEN", "OBJECT_COMMIT_OUTCOME_UNKNOWN", "RECONCILED_COMMITTED", "RECONCILED_NOT_COMMITTED", "RECONCILIATION_REQUIRED_COMMITTED", "RECONCILIATION_REQUIRED_NOT_COMMITTED", "RECONCILIATION_REQUIRED_UNKNOWN", "ABORTED_OWNED_PREPARE", "ABORT_NOT_PROVEN"] }, "object_observations": { "$ref": "#/$defs/ShaArray" }, "effect_observation": { "enum": ["NO_EFFECT", "COMMITTED", "NOT_COMMITTED", "UNKNOWN"] }, "receipt_sequence": { "type": "integer", "minimum": 1 }, "receipt_sha256": { "$ref": "#/$defs/Sha" } },
      "allOf": [
        { "if": { "properties": { "participant_status": { "enum": ["PREPARED_NO_COMMIT", "PREPARE_BLOCKED_NO_EFFECT"] } } }, "then": { "properties": { "participant_phase": { "const": "PREPARE" }, "effect_observation": { "const": "NO_EFFECT" } } } },
        { "if": { "properties": { "participant_status": { "const": "PREPARE_OUTCOME_UNKNOWN" } } }, "then": { "properties": { "participant_phase": { "const": "PREPARE" }, "effect_observation": { "const": "UNKNOWN" } } } },
        { "if": { "properties": { "participant_status": { "const": "OBJECTS_COMMITTED" } } }, "then": { "properties": { "participant_phase": { "const": "COMMIT" }, "effect_observation": { "const": "COMMITTED" } } } },
        { "if": { "properties": { "participant_status": { "const": "OBJECTS_NOT_COMMITTED_PROVEN" } } }, "then": { "properties": { "participant_phase": { "const": "COMMIT" }, "effect_observation": { "const": "NOT_COMMITTED" } } } },
        { "if": { "properties": { "participant_status": { "const": "OBJECT_COMMIT_OUTCOME_UNKNOWN" } } }, "then": { "properties": { "participant_phase": { "const": "COMMIT" }, "effect_observation": { "const": "UNKNOWN" } } } },
        { "if": { "properties": { "participant_status": { "enum": ["RECONCILED_COMMITTED", "RECONCILIATION_REQUIRED_COMMITTED"] } } }, "then": { "properties": { "participant_phase": { "const": "RECONCILE" }, "effect_observation": { "const": "COMMITTED" } } } },
        { "if": { "properties": { "participant_status": { "enum": ["RECONCILED_NOT_COMMITTED", "RECONCILIATION_REQUIRED_NOT_COMMITTED"] } } }, "then": { "properties": { "participant_phase": { "const": "RECONCILE" }, "effect_observation": { "const": "NOT_COMMITTED" } } } },
        { "if": { "properties": { "participant_status": { "const": "RECONCILIATION_REQUIRED_UNKNOWN" } } }, "then": { "properties": { "participant_phase": { "const": "RECONCILE" }, "effect_observation": { "const": "UNKNOWN" } } } },
        { "if": { "properties": { "participant_status": { "const": "ABORTED_OWNED_PREPARE" } } }, "then": { "properties": { "participant_phase": { "const": "ABORT" }, "effect_observation": { "const": "NOT_COMMITTED" } } } },
        { "if": { "properties": { "participant_status": { "const": "ABORT_NOT_PROVEN" } } }, "then": { "properties": { "participant_phase": { "const": "ABORT" }, "effect_observation": { "const": "UNKNOWN" } } } }
      ]
    },
    "ProfileValidationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "protocol_version", "operation_id", "intent_sha256", "operation_profile_id", "parser_id", "transition_validator_id", "semantic_owner_task_id", "validated_payload_sha256", "validation_status", "validation_receipt_sha256"],
      "properties": { "record_type": { "const": "PMST_PROFILE_VALIDATION_RECEIPT_V1" }, "protocol_version": { "const": "PMST_V1" }, "operation_id": { "$ref": "#/$defs/Id" }, "intent_sha256": { "$ref": "#/$defs/Sha" }, "operation_profile_id": { "$ref": "#/$defs/Id" }, "parser_id": { "$ref": "#/$defs/Id" }, "transition_validator_id": { "$ref": "#/$defs/Id" }, "semantic_owner_task_id": { "$ref": "#/$defs/Id" }, "validated_payload_sha256": { "$ref": "#/$defs/Sha" }, "validation_status": { "const": "ACCEPTED" }, "validation_receipt_sha256": { "$ref": "#/$defs/Sha" } }
    },
    "AdmitAcceptedPayload": { "type": "object", "additionalProperties": false, "required": ["admission_binding_sha256"], "properties": { "admission_binding_sha256": { "$ref": "#/$defs/Sha" } } },
    "RejectionPayload": { "type": "object", "additionalProperties": false, "required": ["rejection_class"], "properties": { "rejection_class": { "$ref": "#/$defs/Id" } } },
    "OpenCurrentPayload": { "type": "object", "additionalProperties": false, "required": ["manifest_sha256", "manifest_physical_identity_ref", "state_coordinate_sha256", "security_binding_sha256"], "properties": { "manifest_sha256": { "$ref": "#/$defs/Sha" }, "manifest_physical_identity_ref": { "$ref": "#/$defs/Ref" }, "state_coordinate_sha256": { "$ref": "#/$defs/Sha" }, "security_binding_sha256": { "$ref": "#/$defs/Sha" } } },
    "PreparedPayload": { "type": "object", "additionalProperties": false, "required": ["journal_sha256", "intent_witness_sha256"], "properties": { "journal_sha256": { "$ref": "#/$defs/Sha" }, "intent_witness_sha256": { "$ref": "#/$defs/Sha" } } },
    "ParticipantShaPayload": { "type": "object", "additionalProperties": false, "required": ["participant_receipt_sha256s"], "properties": { "participant_receipt_sha256s": { "$ref": "#/$defs/ShaArray" } } },
    "StagedShaPayload": { "type": "object", "additionalProperties": false, "required": ["staged_identity_sha256s"], "properties": { "staged_identity_sha256s": { "$ref": "#/$defs/ShaArray" } } },
    "ObjectReceiptPayload": { "type": "object", "additionalProperties": false, "required": ["object_receipt_sha256s"], "properties": { "object_receipt_sha256s": { "$ref": "#/$defs/ShaArray" } } },
    "CommitManifestPayload": { "type": "object", "additionalProperties": false, "required": ["prior_manifest_sha256", "successor_manifest_sha256", "successor_physical_identity_ref", "operation_witness_sha256"], "properties": { "prior_manifest_sha256": { "$ref": "#/$defs/Sha" }, "successor_manifest_sha256": { "$ref": "#/$defs/Sha" }, "successor_physical_identity_ref": { "$ref": "#/$defs/NullableRef" }, "operation_witness_sha256": { "$ref": "#/$defs/Sha" } } },
    "ReconcilePayload": { "type": "object", "additionalProperties": false, "required": ["participant_terminal_receipt_sha256s"], "properties": { "participant_terminal_receipt_sha256s": { "$ref": "#/$defs/ShaArray" } } },
    "TerminalPayload": { "type": "object", "additionalProperties": false, "required": ["operation_witness_sha256", "fresh_readback_sha256", "admission_barrier_state"], "properties": { "operation_witness_sha256": { "$ref": "#/$defs/Sha" }, "fresh_readback_sha256": { "$ref": "#/$defs/NullableSha" }, "admission_barrier_state": { "enum": ["OPEN", "CLOSED"] } } },
    "ReadCurrentPayload": { "type": "object", "additionalProperties": false, "required": ["manifest_sha256", "state_coordinate_sha256", "readback_sha256"], "properties": { "manifest_sha256": { "$ref": "#/$defs/Sha" }, "state_coordinate_sha256": { "$ref": "#/$defs/Sha" }, "readback_sha256": { "$ref": "#/$defs/Sha" } } },
    "ReadFailurePayload": { "type": "object", "additionalProperties": false, "required": ["read_failure_class", "failure_observation_sha256"], "properties": { "read_failure_class": { "$ref": "#/$defs/FailureClass" }, "failure_observation_sha256": { "$ref": "#/$defs/Sha" } } },
    "QueryWitnessPayload": { "type": "object", "additionalProperties": false, "required": ["operation_witness_sha256", "fresh_readback_sha256"], "properties": { "operation_witness_sha256": { "$ref": "#/$defs/Sha" }, "fresh_readback_sha256": { "$ref": "#/$defs/Sha" } } },
    "QueryAbsentPayload": { "type": "object", "additionalProperties": false, "required": ["queried_operation_id", "queried_intent_sha256", "absence_observation_sha256"], "properties": { "queried_operation_id": { "$ref": "#/$defs/Id" }, "queried_intent_sha256": { "$ref": "#/$defs/Sha" }, "absence_observation_sha256": { "$ref": "#/$defs/Sha" } } },
    "QueryEvidenceUnavailablePayload": { "type": "object", "additionalProperties": false, "required": ["queried_operation_id", "queried_intent_sha256", "evidence_failure_class", "failure_observation_sha256"], "properties": { "queried_operation_id": { "$ref": "#/$defs/Id" }, "queried_intent_sha256": { "$ref": "#/$defs/Sha" }, "evidence_failure_class": { "$ref": "#/$defs/FailureClass" }, "failure_observation_sha256": { "$ref": "#/$defs/Sha" } } },
    "QueryReadbackUnavailablePayload": { "type": "object", "additionalProperties": false, "required": ["queried_operation_id", "queried_intent_sha256", "operation_witness_sha256", "evidence_failure_class", "failure_observation_sha256"], "properties": { "queried_operation_id": { "$ref": "#/$defs/Id" }, "queried_intent_sha256": { "$ref": "#/$defs/Sha" }, "operation_witness_sha256": { "$ref": "#/$defs/Sha" }, "evidence_failure_class": { "$ref": "#/$defs/FailureClass" }, "failure_observation_sha256": { "$ref": "#/$defs/Sha" } } },
    "ReleasePayload": { "type": "object", "additionalProperties": false, "required": ["release_warning_code"], "properties": { "release_warning_code": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Id" }] } } },
    "PhaseResult": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_version", "record_type", "broker_instance_id", "session_id", "project_registration_id", "operation_id", "operation_kind", "operation_profile_id", "intent_sha256", "request_sha256", "phase", "phase_status", "manifest_commit_observation", "effect_count", "reason_code", "payload", "phase_result_sha256"],
