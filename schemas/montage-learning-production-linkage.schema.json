        "schema_version": { "const": "1.0.0" },
        "message_type": { "const": "Task065PreactivationFixtureValidation" },
        "phase": { "const": "PREACTIVATION" },
        "status": { "const": "SYNTHETIC_FIXTURE_VALIDATED" },
        "evidence_mode": { "const": "SYNTHETIC_PUBLIC_SAFE_FIXTURE" },
        "task072_design_sha256": { "const": "sha256:4f6f21e97d96aa3ffca16f57679abf80d081de6d85d599347fd955c8899ce3c7" },
        "fixture_only": { "const": true },
        "native_broker_executed": { "const": false },
        "operation_id": { "$ref": "#/$defs/OperationId" },
        "install_instance_id": { "$ref": "#/$defs/InstallInstanceId" },
        "record_id": { "$ref": "#/$defs/RecordId" },
        "learning_sha256": { "$ref": "#/$defs/Sha256" },
        "profile_id": { "$ref": "#/$defs/ProfileId" },
        "profile_sha256": { "$ref": "#/$defs/Sha256" },
        "public_receipt_id": { "$ref": "#/$defs/ReceiptId" },
        "plan_sha256": { "$ref": "#/$defs/Sha256" },
        "task036_completion_receipt_sha256": { "$ref": "#/$defs/Sha256" },
        "task061b_completion_receipt_sha256": { "$ref": "#/$defs/Sha256" },
        "public_receipt_sha256": { "$ref": "#/$defs/Sha256" },
        "canonical_readback_sha256": { "$ref": "#/$defs/Sha256" },
        "profile_readback_sha256": { "$ref": "#/$defs/Sha256" },
        "evidence_binding_sha256": { "$ref": "#/$defs/Sha256" },
        "hidden_correlation_fixture_matched": { "const": true },
        "historical_stage_invocation_count": { "const": 1 },
        "historical_import_invocation_count": { "const": 1 },
        "task065_adapter_call_count": { "const": 0 },
        "task065_task036_call_count": { "const": 0 },
        "project_delta_count": { "const": 0 },
        "bridge_delta_count": { "const": 0 },
        "profile_delta_count": { "const": 0 },
        "config_delta_count": { "const": 0 },
        "history_delta_count": { "const": 0 },
        "authority_created": { "const": false },
        "activation_authorized": { "const": false },
        "steady_state_authorized": { "const": false },
        "real_installed_adapter_verified": { "const": false },
        "activation_prerequisite_satisfied": { "const": false },
        "production_chain_complete": { "const": false },
        "task072_implementation_receipt_verified": { "const": false },
