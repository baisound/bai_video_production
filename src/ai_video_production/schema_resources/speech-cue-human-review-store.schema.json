{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baisound/bai_video_production/schemas/speech-cue-human-review-store.schema.json",
  "title": "TASK-056 Speech Cue Human Review Store",
  "type": "object",
  "required": [
    "review_store_version", "task_owner", "project_id", "manifest_id",
    "manifest_sha256", "source_asset_id", "revision", "decisions",
    "confirmation_tokens_persisted", "transcript_text_persisted",
    "host_paths_persisted", "canonical_timeline", "auto_apply_authorized",
    "review_store_sha256"
  ],
  "properties": {
    "review_store_version": {"const": "1.0.0"},
    "task_owner": {"const": "TASK-056"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "manifest_id": {"type": "string", "pattern": "^SCM-[0-9a-f]{32}$"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_asset_id": {"type": "string", "pattern": "^ASSET-[0-9A-HJKMNP-TV-Z]{26}$"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 10000},
    "decisions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["decision_id", "cue_id", "cue_sha256", "decision", "actor_id", "decided_at"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^SCD-[0-9a-f]{24}$"},
          "cue_id": {"type": "string", "pattern": "^CUE-[0-9a-f]{24}$"},
          "cue_sha256": {"$ref": "#/$defs/sha256"},
          "decision": {"enum": ["ACCEPT", "REJECT"]},
          "actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "decided_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}
        },
        "additionalProperties": false
      }
    },
    "confirmation_tokens_persisted": {"const": false},
    "transcript_text_persisted": {"const": false},
    "host_paths_persisted": {"const": false},
    "canonical_timeline": {"const": false},
    "auto_apply_authorized": {"const": false},
    "review_store_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}