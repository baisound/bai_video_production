{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/perk-identity.schema.json",
  "title": "TASK-049 DbD Perk Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "perk_id",
    "slug",
    "role",
    "owner_character_id",
    "introduced_version",
    "retired_version",
    "active",
    "created_at",
    "perk_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "perk_id": {
      "type": "string",
      "pattern": "^perk_[a-z0-9][a-z0-9_]{1,123}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,126}$"
    },
    "role": {
      "enum": [
        "SURVIVOR",
        "KILLER"
      ]
    },
    "owner_character_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "introduced_version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*))?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retired_version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*))?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "perk_identity_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
