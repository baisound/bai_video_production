        "record_type": { "const": "OwnerVoiceRegistryAmendmentProposal" },
        "amendment_id": { "$ref": "#/$defs/identifier" },
        "human_action_registry_version": { "const": "HUMAN_ACTION_REGISTRY_V2" },
        "operation_profile_registry_version": { "const": "ACTION_REGISTRY_V2" },
        "human_action_rows": {
          "const": [
            { "action_code": "OWNER_VOICE_REFERENCE_PREPARE_V1", "purpose": "PRIVATE_REFERENCE_PAIR_PREPARATION", "effect_ceiling": "ONE_PREPARE_OPERATION" },
            { "action_code": "OWNER_VOICE_LOCAL_INFERENCE_V1", "purpose": "TASK075_LOCAL_SYNTHESIS", "effect_ceiling": "ONE_INFERENCE_OPERATION" },
            { "action_code": "OWNER_VOICE_LISTENING_DECISION_V1", "purpose": "TASK041_LISTENING_DECISION", "effect_ceiling": "ONE_DECISION" },
