        "generation_after": {"type": "integer", "minimum": 1},
        "head_before_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "head_after_sha256": {"$ref": "#/$defs/sha256"},
        "latest_before": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "latest_after": {"type": "integer", "minimum": 1},
        "revision_count_before": {"type": "integer", "minimum": 0},
        "revision_count_after": {"type": "integer", "minimum": 1},
        "atomic_cas": {"type": "boolean"},
        "read_back_verified": {"type": "boolean"},
        "result_state": {"enum": ["VERIFIED_COMMITTED", "UNKNOWN", "CORRUPT_OR_INCOMPLETE", "CONFLICT"]},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "VoiceDatasetCommitEnvelope": {
      "type": "object",
      "required": ["record_type", "operation_id", "idempotency_key", "intent_sha256", "revision_sha256", "receipt_sha256", "previous_envelope_sha256", "created_at", "envelope_sha256"],
      "properties": {
        "record_type": {"const": "VoiceDatasetCommitEnvelope"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "idempotency_key": {"$ref": "#/$defs/identifier"},
        "intent_sha256": {"$ref": "#/$defs/sha256"},
        "revision_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "previous_envelope_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "envelope_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "DatasetStorePersistenceCapabilityBinding": {
      "type": "object",
      "required": ["record_type", "contract_state", "canonical_owner_ref", "canonical_owner_sha256", "api_version", "atomic_full_store_cas", "authoritative_read_back", "history_reconciliation", "evidence_ref", "evidence_sha256", "capability_sha256"],
      "properties": {
        "record_type": {"const": "DatasetStorePersistenceCapabilityBinding"},
        "contract_state": {"enum": ["CANONICAL_REF_NOT_PROVIDED", "BOUND_VERIFIED", "MISMATCH", "UNKNOWN"]},
        "canonical_owner_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "canonical_owner_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "api_version": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "atomic_full_store_cas": {"type": ["boolean", "null"]},
        "authoritative_read_back": {"type": ["boolean", "null"]},
        "history_reconciliation": {"type": ["boolean", "null"]},
        "evidence_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "capability_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "StoreCommitBinding": {
      "type": "object",
      "required": ["record_type", "contract_state", "authoritative_store_sha256", "store_generation", "head_revision_sha256", "latest_revision_number", "revision_count", "committed_envelope_sha256", "read_back_evidence_ref", "read_back_evidence_sha256", "observed_at", "reason_code", "binding_sha256"],
      "properties": {
        "record_type": {"const": "StoreCommitBinding"},
        "contract_state": {"enum": ["BOUND_VERIFIED", "MISMATCH", "UNKNOWN"]},
        "authoritative_store_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "store_generation": {"type": ["integer", "null"], "minimum": 1},
        "head_revision_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "latest_revision_number": {"type": ["integer", "null"], "minimum": 1},
        "revision_count": {"type": ["integer", "null"], "minimum": 1},
        "committed_envelope_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "read_back_evidence_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "read_back_evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "observed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "reason_code": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
