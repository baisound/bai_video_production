  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "MONTAGE_LEARNING_CANONICAL_PREFLIGHT"},
    "task_owner": {"const": "TASK-058"},
    "source_contract_profile": {"const": "bvp-task058-montage-exact-evidence-v1"},
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"
    },
    "source_record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"
    },
    "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "owner_scope_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proposal_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approved_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "idempotency_key_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "staging_entry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "canonical_evidence_id": {
      "type": "string",
      "pattern": "^task055-evidence-[0-9a-f]{64}$"
    },
    "canonical_evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "human_binding_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "admission_state": {"const": "NONAUTHORITATIVE_SOURCE_HUMAN_PREFLIGHT_PROJECTION"},
    "projection_structure_valid": {"const": true},
    "compiler_execution_verified": {"const": false},
    "source_lineage_origin_verified": {"const": false},
    "human_binding_origin_verified": {"const": false},
    "staging_entry_origin_verified": {"const": false},
    "staging_membership_verified": {"const": false},
    "staging_store_origin_verified": {"const": false},
    "do_not_learn": {"const": false},
    "negative_feedback_preserved": {"type": "boolean"},
    "monotonic_project_anchor_verified": {"const": false},
    "rollback_detection_authority_created": {"const": false},
    "canonical_store_written": {"const": false},
    "canonical_store_commit_sha256": {"type": "null"},
    "receipt_minted": {"const": false},
    "canonical_admission_authority_created": {"const": false},
    "automatic_learning_promotion_authorized": {"const": false},
    "timeline_mutation_authorized": {"const": false},
    "resolve_write_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "preflight_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
