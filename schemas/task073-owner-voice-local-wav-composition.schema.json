      "then": {"properties": {"receipts": {"properties": {"installed_session": {"not": {"type": "null"}}}}}}
    },
    {
      "if": {"properties": {"receipts": {"properties": {"reference": {"not": {"type": "null"}}}}}},
      "then": {"properties": {"receipts": {"properties": {"quick_clone": {"not": {"type": "null"}}}}}}
    },
    {
      "if": {"properties": {"receipts": {"properties": {"selection": {"not": {"type": "null"}}}}}},
