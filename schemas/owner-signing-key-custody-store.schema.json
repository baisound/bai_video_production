{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai-video-production.local/schemas/owner-signing-key-custody-store.schema.json",
  "title": "TASK-029 encrypted Owner signing key custody store",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "task_owner",
    "cipher_suite",
    "ciphertext_b64",
    "ciphertext_sha256",
    "plaintext_fields_present",
    "document_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "OWNER_SIGNING_KEY_CUSTODY_STORE_ENCRYPTED"},
    "task_owner": {"const": "TASK-029"},
    "cipher_suite": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "ciphertext_b64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 87384,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "ciphertext_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plaintext_fields_present": {"const": false},
    "document_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
