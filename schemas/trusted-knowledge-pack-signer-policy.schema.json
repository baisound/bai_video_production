{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/trusted-knowledge-pack-signer-policy.schema.json",
  "title": "TASK-029 R9A Trusted Knowledge Pack Signer Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version", "record_type", "task_owner", "policy_id",
    "signature_algorithm", "trusted_signer_key_ids", "state",
    "private_key_material_included", "signature_authorized",
    "knowledge_pack_write_authorized", "automatic_promotion_authorized",
    "trusted_signer_policy_sha256"
  ],
  "properties": {
    "policy_version": {"const": "1.0.0"},
    "record_type": {"const": "TRUSTED_KNOWLEDGE_PACK_SIGNER_POLICY"},
    "task_owner": {"const": "TASK-029"},
    "policy_id": {"$ref": "#/$defs/stableId"},
    "signature_algorithm": {"const": "ED25519"},
    "trusted_signer_key_ids": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}
    },
    "state": {"enum": ["ACTIVE", "REVOKED"]},
    "private_key_material_included": {"const": false},
    "signature_authorized": {"const": false},
    "knowledge_pack_write_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "trusted_signer_policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"}
  }
}
