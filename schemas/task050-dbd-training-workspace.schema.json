{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TASK-050 Workspace Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "display_name",
    "root_path"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "root_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
