{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baisound/bai_video_production/schemas/product-project-manifest.schema.json",
  "title": "BAI Video Production Product Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_format_id",
    "project_format_version",
    "project_id",
    "project_revision",
    "created_at",
    "updated_at",
    "product_version",
    "timebase",
    "child_bindings",
    "authority",
    "secrets_embedded",
    "media_bytes_embedded",
    "project_manifest_sha256"
  ],
  "properties": {
    "project_format_id": {"const": "bai-video-production.project"},
    "project_format_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "project_revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "updated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "product_version": {"$ref": "#/$defs/semver"},
    "timebase": {"$ref": "#/$defs/timebase"},
    "child_bindings": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/childBinding"}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_execution_authorized",
        "paid_execution_authorized",
        "native_execution_authorized",
        "external_mutation_authorized"
      ],
      "properties": {
        "provider_execution_authorized": {"const": false},
        "paid_execution_authorized": {"const": false},
        "native_execution_authorized": {"const": false},
        "external_mutation_authorized": {"const": false}
      }
    },
    "secrets_embedded": {"const": false},
    "media_bytes_embedded": {"const": false},
    "project_manifest_sha256": {"$ref": "#/$defs/checksum"}
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "childBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_owner",
        "relative_path",
        "format_id",
        "format_version",
        "content_sha256",
        "required",
        "dependency_hashes"
      ],
      "properties": {
        "domain_owner": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:[-./][A-Z0-9]+)*$",
          "maxLength": 128
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.bai-project(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]{1,512}$"
        },
        "format_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*)+$",
          "maxLength": 128
        },
        "format_version": {"$ref": "#/$defs/semver"},
        "content_sha256": {"$ref": "#/$defs/checksum"},
        "required": {"type": "boolean"},
        "dependency_hashes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/checksum"}
        }
      }
    }
  }
}
