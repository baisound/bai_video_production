{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.local/schemas/task100-local-voice-catalog-consumer.schema.json",
  "title": "TASK-100 Local Voice Catalog Consumer Readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "record_type",
    "candidate_sha256",
    "assessment_sha256",
    "admission_sha256",
    "producer_readback_set_sha256",
    "inventory_sha256",
    "inventory_candidate_sha256",
    "route_selection_sha256",
    "route_currentness_evaluation_sha256",
    "route_currentness_readback_set_sha256",
    "narration_preflight_sha256",
    "project_id",
    "voice_profile_id",
    "voice_profile_revision_sha256",
    "model_candidate_revision_sha256",
    "installed_binding_sha256",
    "license_evidence_sha256",
    "model_pair_sha256",
    "engine_id",
    "evaluated_at",
    "consumer_live_eligible",
    "reason_codes",
    "authority_kind",
    "authority_created",
    "execution_authorized",
    "load_lease_created",
    "runtime_started",
    "model_loaded",
    "inference_started",
    "audio_body_persisted",
    "host_path_persisted",
    "resource_effect_count",
    "consumer_readback_sha256"
  ],
  "properties": {
    "contract_version": {"const": "LOCAL_VOICE_CATALOG_CONSUMER_READBACK_V1"},
    "record_type": {"const": "LocalVoiceCatalogConsumerReadbackV1"},
    "candidate_sha256": {"$ref": "#/$defs/digest"},
    "assessment_sha256": {"$ref": "#/$defs/digest"},
    "admission_sha256": {"$ref": "#/$defs/digest"},
    "producer_readback_set_sha256": {"$ref": "#/$defs/digest"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "inventory_candidate_sha256": {"$ref": "#/$defs/digest"},
    "route_selection_sha256": {"$ref": "#/$defs/digest"},
    "route_currentness_evaluation_sha256": {"$ref": "#/$defs/digest"},
    "route_currentness_readback_set_sha256": {"$ref": "#/$defs/digest"},
    "narration_preflight_sha256": {"$ref": "#/$defs/digest"},
    "project_id": {"$ref": "#/$defs/publicId"},
    "voice_profile_id": {"$ref": "#/$defs/publicId"},
    "voice_profile_revision_sha256": {"$ref": "#/$defs/digest"},
    "model_candidate_revision_sha256": {"$ref": "#/$defs/digest"},
    "installed_binding_sha256": {"$ref": "#/$defs/digest"},
    "license_evidence_sha256": {"$ref": "#/$defs/digest"},
    "model_pair_sha256": {"$ref": "#/$defs/digest"},
    "engine_id": {"$ref": "#/$defs/publicId"},
    "evaluated_at": {"$ref": "#/$defs/timestamp"},
    "consumer_live_eligible": {"type": "boolean"},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4,
      "items": {
        "enum": [
          "CATALOG_ADMISSION_NOT_ADMITTED",
          "INVENTORY_CANDIDATE_NOT_SELECTABLE",
          "ROUTE_CURRENTNESS_NOT_RUNNABLE",
          "NARRATION_PREFLIGHT_NOT_READY"
        ]
      }
    },
    "authority_kind": {"const": "EVIDENCE_ONLY"},
    "authority_created": {"const": false},
    "execution_authorized": {"const": false},
    "load_lease_created": {"const": false},
    "runtime_started": {"const": false},
    "model_loaded": {"const": false},
    "inference_started": {"const": false},
    "audio_body_persisted": {"const": false},
    "host_path_persisted": {"const": false},
    "resource_effect_count": {"const": 0},
    "consumer_readback_sha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"consumer_live_eligible": {"const": true}}},
      "then": {"properties": {"reason_codes": {"maxItems": 0}}},
      "else": {"properties": {"reason_codes": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publicId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:(?:(?!0000)[0-9]{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00))-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    }
  }
}

