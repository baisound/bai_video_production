{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/game-knowledge-ref.schema.json",
  "title": "TASK-049 Game Knowledge Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_kind",
    "entity_id",
    "revision_id",
    "environment",
    "game_version_from",
    "game_version_to",
    "source_provenance_ref",
    "knowledge_ref_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "knowledge_kind": {
      "enum": [
        "PERK",
        "KILLER",
        "POWER",
        "MAP",
        "REALM",
        "TILE",
        "ADDON",
        "ITEM",
        "OFFERING",
        "STATUS",
        "MECHANIC"
      ]
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "environment": {
      "enum": [
        "LIVE",
        "PTB",
        "UNKNOWN"
      ]
    },
    "game_version_from": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "game_version_to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "source_provenance_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "knowledge_ref_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
