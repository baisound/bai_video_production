        "audio_body_persisted": {"const": false},
        "raw_sample_body_persisted": {"const": false},
        "transcript_body_persisted": {"const": false},
        "credential_value_persisted": {"const": false},
        "host_absolute_path_persisted": {"const": false},
        "device_fingerprint_public": {"const": false},
        "capture_or_staging_write_authorized": {"const": false},
        "asset_effect_authorized": {"const": false},
        "analyzer_execution_authorized": {"const": false},
        "obs_rx_device_effect_authorized": {"const": false},
        "dataset_training_production_authorized": {"const": false}
      }
