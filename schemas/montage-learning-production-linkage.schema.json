        "task065_adapter_call_count",
        "task065_task036_call_count",
        "project_delta_count",
        "bridge_delta_count",
        "profile_delta_count",
        "config_delta_count",
        "history_delta_count",
        "authority_created",
        "activation_authorized",
        "steady_state_authorized",
        "real_installed_adapter_verified",
