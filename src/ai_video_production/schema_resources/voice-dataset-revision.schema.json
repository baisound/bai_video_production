        "operation_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "idempotency_key": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "job_kind": {"type": ["string", "null"]},
        "job_revision": {"type": ["integer", "null"], "minimum": 1},
        "job_revision_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "job_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "canonical_job_evidence_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "canonical_job_evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "identity_shared_with_training_job": {"const": false},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
