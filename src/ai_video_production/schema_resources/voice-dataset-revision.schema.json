      "properties": {
        "record_type": {"const": "DurableDatasetAdoptionJobBinding"},
        "contract_state": {"enum": ["CANONICAL_REF_NOT_PROVIDED", "BOUND_VERIFIED", "MISMATCH", "UNKNOWN"]},
