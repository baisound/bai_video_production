      "then": {"properties": {"receipts": {"properties": {"quick_clone": {"type": "object"}, "listening_join": {"type": "object"}}, "anyOf": [{"properties": {"quick_clone": {"type": "object", "properties": {"producer_state": {"const": "RETEST_REQUIRED"}}}}}, {"properties": {"listening_join": {"type": "object", "properties": {"producer_state": {"const": "RETEST_REQUIRED"}}}}}]}}}
    },
    {
      "if": {"properties": {"derived_state": {"const": "BLOCKED"}}},
      "then": {"properties": {"reason_codes": {"minItems": 1}}},
      "else": {"properties": {"reason_codes": {"maxItems": 0}}}
    },
    {
