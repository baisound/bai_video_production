{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/canonical-game-event-timeline.schema.json",
  "title": "TASK-049 Canonical Game Event Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timeline_revision",
    "match",
    "events",
    "created_at",
    "timeline_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "timeline_revision": {
      "type": "integer",
      "minimum": 1
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "match_id",
        "production_job_id",
        "source_asset_id",
        "game_profile_id",
        "game_profile_version",
        "game_version",
        "environment",
        "perspective",
        "source_rate",
        "analysis_revision",
        "status",
        "created_at",
        "match_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "match_id": {
          "type": "string",
          "pattern": "^MATCH-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "production_job_id": {
          "type": "string",
          "pattern": "^JOB-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "source_asset_id": {
          "type": "string",
          "pattern": "^ASSET-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "game_profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        },
        "game_profile_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "game_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "environment": {
          "enum": [
            "LIVE",
            "PTB",
            "UNKNOWN"
          ]
        },
        "perspective": {
          "enum": [
            "SURVIVOR",
            "KILLER",
            "SPECTATOR",
            "UNKNOWN"
          ]
        },
        "source_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "analysis_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "CREATED",
            "ANALYZING",
            "NEEDS_REVIEW",
            "REVIEWED",
            "COMPLETE",
            "FAILED"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "match_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "event_id",
          "match_id",
          "revision",
          "event_type",
          "source_range",
          "game_version",
          "environment",
          "perspective",
          "state",
          "confidence_milli",
          "confirmation_state",
          "evidence_refs",
          "knowledge_refs",
          "review_status",
          "created_at",
          "event_sha256"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          },
          "event_id": {
            "type": "string",
            "pattern": "^GEVT-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "match_id": {
            "type": "string",
            "pattern": "^MATCH-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "event_type": {
            "enum": [
              "MATCH_START",
              "CHASE_START",
              "CHASE_END",
              "INJURY",
              "DOWN",
              "HOOK",
              "UNHOOK",
              "WINDOW_VAULT",
              "PALLET_DROP",
              "KILL",
              "ESCAPE",
              "UNKNOWN_EVENT"
            ]
          },
          "source_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_frame",
              "end_frame_exclusive"
            ],
            "properties": {
              "start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "end_frame_exclusive": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "game_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
          },
          "environment": {
            "enum": [
              "LIVE",
              "PTB",
              "UNKNOWN"
            ]
          },
          "perspective": {
            "enum": [
              "SURVIVOR",
              "KILLER",
              "SPECTATOR",
              "UNKNOWN"
            ]
          },
          "state": {
            "type": "object"
          },
          "confidence_milli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "confirmation_state": {
            "enum": [
              "DETECTED",
              "POSSIBLE",
              "CONFIRMED",
              "REJECTED",
              "UNKNOWN",
              "NEEDS_REVIEW"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^GEVD-[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "knowledge_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "knowledge_kind",
                "entity_id",
                "revision_id",
                "environment",
                "game_version_from",
                "game_version_to",
                "source_provenance_ref",
                "knowledge_ref_sha256"
              ],
              "properties": {
                "schema_version": {
                  "const": "1.0.0"
                },
                "knowledge_kind": {
                  "enum": [
                    "PERK",
                    "KILLER",
                    "POWER",
                    "MAP",
                    "REALM",
                    "TILE",
                    "ADDON",
                    "ITEM",
                    "OFFERING",
                    "STATUS",
                    "MECHANIC"
                  ]
                },
                "entity_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
                },
                "revision_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "environment": {
                  "enum": [
                    "LIVE",
                    "PTB",
                    "UNKNOWN"
                  ]
                },
                "game_version_from": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
                },
                "game_version_to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
                },
                "source_provenance_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "knowledge_ref_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          },
          "review_status": {
            "enum": [
              "PENDING",
              "AUTO_ACCEPTED",
              "HUMAN_APPROVED",
              "HUMAN_CORRECTED",
              "HUMAN_REJECTED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "event_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "timeline_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
