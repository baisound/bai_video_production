          "else": {
            "properties": {
              "reference_preparation_receipt_sha256": { "type": "null" },
              "reference_capability_binding_sha256": { "type": "null" },
              "reference_media_policy_sha256": { "type": "null" },
              "reference_transcript_binding_receipt_sha256": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "persistence_state": { "const": "DURABLE_VERIFIED" } }, "required": ["persistence_state"] },
          "then": { "properties": { "route_selection_store_receipt_sha256": { "$ref": "#/$defs/sha256" } } },
          "else": { "properties": { "route_selection_store_receipt_sha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "completion_class": { "const": "TASK074_IMPLEMENTATION_COMPLETE" } }, "required": ["completion_class"] },
          "then": { "properties": { "owner_reference_verified": { "const": false } } },
          "else": {
