{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/knowledge-pack-signing-candidate.schema.json",
  "title": "TASK-029 R7 Knowledge Pack Signing Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version", "record_type", "task_owner", "compatibility_contract",
    "signing_candidate_id", "pack_id", "pack_version", "source_candidate_id",
    "source_candidate_sha256", "source_feature_rule_sha256", "source_policy_sha256",
    "predecessor_pack_sha256", "human_review_id", "human_review_sha256",
    "critic_review_id", "critic_review_sha256", "state",
    "owner_scope_coordinates_included", "project_scope_coordinates_included",
    "reviewer_coordinates_included", "raw_media_included", "text_body_included",
    "absolute_host_path_included", "credential_included", "signing_key_material_included",
    "signature_present", "signature_verified", "latest_source_revalidation_required",
    "external_signature_required", "in_memory_candidate_only",
    "knowledge_pack_write_authorized", "knowledge_pack_promotion_authorized",
    "automatic_promotion_authorized", "runtime_profile_apply_authorized",
    "rollback_execution_authorized", "release_authorized", "external_effect_authorized",
    "signing_candidate_sha256"
  ],
  "properties": {
    "candidate_version": {"const": "1.0.0"},
    "record_type": {"const": "KNOWLEDGE_PACK_SIGNING_CANDIDATE"},
    "task_owner": {"const": "TASK-029"},
    "compatibility_contract": {"const": "TASK-029/KNOWLEDGE_PACK/1.0.0"},
    "signing_candidate_id": {"$ref": "#/$defs/stableId"},
    "pack_id": {"$ref": "#/$defs/stableId"},
    "pack_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_candidate_id": {"$ref": "#/$defs/stableId"},
    "source_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "source_feature_rule_sha256": {"$ref": "#/$defs/sha256"},
    "source_policy_sha256": {"$ref": "#/$defs/sha256"},
    "predecessor_pack_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "human_review_id": {"$ref": "#/$defs/stableId"},
    "human_review_sha256": {"$ref": "#/$defs/sha256"},
    "critic_review_id": {"$ref": "#/$defs/stableId"},
    "critic_review_sha256": {"$ref": "#/$defs/sha256"},
    "state": {"enum": ["READY_FOR_EXTERNAL_SIGNATURE", "HUMAN_REJECTED", "CRITIC_REJECTED"]},
    "owner_scope_coordinates_included": {"const": false},
    "project_scope_coordinates_included": {"const": false},
    "reviewer_coordinates_included": {"const": false},
    "raw_media_included": {"const": false},
    "text_body_included": {"const": false},
    "absolute_host_path_included": {"const": false},
    "credential_included": {"const": false},
    "signing_key_material_included": {"const": false},
    "signature_present": {"const": false},
    "signature_verified": {"const": false},
    "latest_source_revalidation_required": {"const": true},
    "external_signature_required": {"const": true},
    "in_memory_candidate_only": {"const": true},
    "knowledge_pack_write_authorized": {"const": false},
    "knowledge_pack_promotion_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "runtime_profile_apply_authorized": {"const": false},
    "rollback_execution_authorized": {"const": false},
    "release_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "signing_candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"}
  }
}
