{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.dev/schemas/packaging-parser-pin-observation.schema.json",
  "title": "TASK-014 Packaging Parser Pin Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","observer_id","observer_revision","evaluated_at","decision","reason_codes",
    "request_url","request_method","request_scheduled_count","request_sent_count","request_send_state","response_headers_observed","response_body_complete","response_bytes","response_sha256",
    "resolved_address_count","resolved_address_count_overflow","all_resolved_addresses_global","connected_peer_in_resolved_set",
    "tls_certificate_verified","redirect_count","content_type","distribution_name",
    "distribution_version","wheel_filename","wheel_bytes","wheel_sha256","metadata_sha256",
    "source_url","official_metadata_observation_complete","pin_acceptance_authorized",
    "artifact_body_observed","diagnostic_only","persistent_receipt_is_capability",
    "artifact_download_authorized","parser_import_authorized","resolver_use_authorized",
    "install_authorized","post_return_state_guaranteed","consumer_revalidation_required",
    "metadata_network_accessed","metadata_response_observed","credentials_sent","artifact_body_downloaded","package_installed",
    "parser_imported","target_runtime_executed","model_loaded","audio_read","native_transport_origin_authenticated","receipt_sha256"
  ],
  "properties": {
    "schema_version":{"const":"bai.task014.packaging-parser-pin-observation.v2"},
    "observer_id":{"const":"bai.task014.packaging-parser-pin-observer"},
    "observer_revision":{"const":2},
    "evaluated_at":{"type":"string","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?Z$"},
    "decision":{"enum":["OFFICIAL_PACKAGING_PIN_OBSERVED_DIAGNOSTIC","BLOCKED","UNKNOWN"]},
    "reason_codes":{"type":"array","items":{"type":"string","minLength":1,"maxLength":64},"maxItems":1},
    "request_url":{"const":"https://pypi.org/pypi/packaging/25.0/json"},
    "request_method":{"const":"GET"},
    "request_scheduled_count":{"const":1},
    "request_sent_count":{"type":"integer","minimum":0,"maximum":1},
    "request_send_state":{"enum":["NOT_ATTEMPTED","UNKNOWN_PARTIAL","COMPLETE"]},
    "response_headers_observed":{"type":"boolean"},
    "response_body_complete":{"type":"boolean"},
    "response_bytes":{"type":"integer","minimum":0,"maximum":1048576},
    "response_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
    "resolved_address_count":{"type":"integer","minimum":0,"maximum":32},
    "resolved_address_count_overflow":{"type":"boolean"},
    "all_resolved_addresses_global":{"type":"boolean"},
    "connected_peer_in_resolved_set":{"type":"boolean"},
    "tls_certificate_verified":{"type":"boolean"},
    "redirect_count":{"const":0},
    "content_type":{"oneOf":[{"const":"application/json"},{"type":"null"}]},
    "distribution_name":{"const":"packaging"},
    "distribution_version":{"const":"25.0"},
    "wheel_filename":{"const":"packaging-25.0-py3-none-any.whl"},
    "wheel_bytes":{"const":66469},
    "wheel_sha256":{"const":"sha256:29572ef2b1f17581046b3a2227d5c611fb25ec70ca1ba8554b24b0e69331a484"},
    "metadata_sha256":{"const":"sha256:5b611a609c38fefc3d616bf45d20aec98fb7d53f245daca9e2c30fc85c7ac282"},
    "source_url":{"const":"https://files.pythonhosted.org/packages/20/12/38679034af332785aac8774540895e234f4d07f7545804097de4b666afd8/packaging-25.0-py3-none-any.whl"},
    "official_metadata_observation_complete":{"type":"boolean"},
    "pin_acceptance_authorized":{"const":false},
    "artifact_body_observed":{"const":false},
    "diagnostic_only":{"const":true},
    "persistent_receipt_is_capability":{"const":false},
    "artifact_download_authorized":{"const":false},
    "parser_import_authorized":{"const":false},
    "resolver_use_authorized":{"const":false},
    "install_authorized":{"const":false},
    "post_return_state_guaranteed":{"const":false},
    "consumer_revalidation_required":{"const":true},
    "metadata_network_accessed":{"const":true},
    "metadata_response_observed":{"type":"boolean"},
    "credentials_sent":{"const":false},
    "artifact_body_downloaded":{"const":false},
    "package_installed":{"const":false},
    "parser_imported":{"const":false},
    "target_runtime_executed":{"const":false},
    "model_loaded":{"const":false},
    "audio_read":{"const":false},
    "native_transport_origin_authenticated":{"const":false},
    "receipt_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},
  "allOf":[
    {"if":{"properties":{"decision":{"const":"OFFICIAL_PACKAGING_PIN_OBSERVED_DIAGNOSTIC"}},"required":["decision"]},
     "then":{"properties":{
       "reason_codes":{"const":[]},"response_bytes":{"minimum":1},"response_sha256":{"$ref":"#/$defs/sha256"},
       "resolved_address_count":{"minimum":1},"all_resolved_addresses_global":{"const":true},
       "connected_peer_in_resolved_set":{"const":true},"tls_certificate_verified":{"const":true},
       "content_type":{"const":"application/json"},"official_metadata_observation_complete":{"const":true},
       "metadata_network_accessed":{"const":true},"metadata_response_observed":{"const":true},
       "request_sent_count":{"const":1},"request_send_state":{"const":"COMPLETE"},"resolved_address_count_overflow":{"const":false},"response_headers_observed":{"const":true},"response_body_complete":{"const":true}
      }}},
    {"if":{"properties":{"decision":{"enum":["BLOCKED","UNKNOWN"]}},"required":["decision"]},
     "then":{"properties":{
       "reason_codes":{"minItems":1,"maxItems":1},"official_metadata_observation_complete":{"const":false}
      }}
     },
    {"if":{"properties":{"decision":{"const":"BLOCKED"}},"required":["decision"]},
      "then":{"properties":{"reason_codes":{"type":"array","minItems":1,"maxItems":1,"items":{"enum":["DNS_NON_GLOBAL_OR_AMBIGUOUS","CONNECTED_PEER_NOT_IN_RESOLVED_SET","REDIRECT_REJECTED","HTTP_STATUS_REJECTED","CONTENT_TYPE_REJECTED","CONTENT_ENCODING_REJECTED","TRANSFER_ENCODING_REJECTED","CONTENT_LENGTH_REQUIRED","RESPONSE_BOUNDS_EXCEEDED","RESPONSE_HEADERS_BOUNDS_EXCEEDED","RESPONSE_HEADERS_MALFORMED","TRANSPORT_FACTS_MISMATCH","METADATA_JSON_MALFORMED","INFO_MALFORMED","DIGESTS_MALFORMED","CORE_METADATA_MALFORMED","PROJECT_IDENTITY_MISMATCH","VULNERABILITY_STATE_NOT_EMPTY","RELEASE_FILE_SET_MALFORMED","PIN_CANDIDATE_COUNT_MISMATCH","PIN_COORDINATE_MISMATCH","PIN_DIGEST_MISMATCH","METADATA_DIGEST_MISMATCH"]}}}}},
    {"if":{"properties":{"decision":{"const":"UNKNOWN"}},"required":["decision"]},
      "then":{"properties":{"reason_codes":{"type":"array","minItems":1,"maxItems":1,"items":{"enum":["DNS_LOOKUP_FAILED","CONNECTION_FAILED","TLS_VERIFICATION_FAILED","REQUEST_SEND_FAILED","RESPONSE_READ_FAILED"]}}}}},
    {"if":{"properties":{"resolved_address_count_overflow":{"const":true}},"required":["resolved_address_count_overflow"]},"then":{"properties":{"resolved_address_count":{"const":32},"all_resolved_addresses_global":{"const":false}}}},
    {"if":{"properties":{"request_send_state":{"const":"NOT_ATTEMPTED"}},"required":["request_send_state"]},"then":{"properties":{"request_sent_count":{"const":0}}}},
    {"if":{"properties":{"request_send_state":{"const":"UNKNOWN_PARTIAL"}},"required":["request_send_state"]},"then":{"properties":{"request_sent_count":{"const":0},"connected_peer_in_resolved_set":{"const":true},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"request_send_state":{"const":"COMPLETE"}},"required":["request_send_state"]},"then":{"properties":{"request_sent_count":{"const":1}}}},
    {"if":{"properties":{"resolved_address_count":{"const":0}},"required":["resolved_address_count"]},"then":{"properties":{"all_resolved_addresses_global":{"const":false},"tls_certificate_verified":{"const":false},"connected_peer_in_resolved_set":{"const":false},"request_sent_count":{"const":0},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"all_resolved_addresses_global":{"const":false}},"required":["all_resolved_addresses_global"]},"then":{"properties":{"tls_certificate_verified":{"const":false},"connected_peer_in_resolved_set":{"const":false},"request_sent_count":{"const":0},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"tls_certificate_verified":{"const":false}},"required":["tls_certificate_verified"]},"then":{"properties":{"connected_peer_in_resolved_set":{"const":false},"request_sent_count":{"const":0},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"connected_peer_in_resolved_set":{"const":false}},"required":["connected_peer_in_resolved_set"]},"then":{"properties":{"request_sent_count":{"const":0},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"request_sent_count":{"const":0}},"required":["request_sent_count"]},"then":{"properties":{"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"response_headers_observed":{"const":false}},"required":["response_headers_observed"]},"then":{"properties":{"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"content_type":{"const":"application/json"}},"required":["content_type"]},"then":{"properties":{"response_headers_observed":{"const":true}}}},
    {"if":{"properties":{"response_body_complete":{"const":false}},"required":["response_body_complete"]},"then":{"properties":{"metadata_response_observed":{"const":false},"response_bytes":{"const":0},"response_sha256":{"type":"null"}}}},
    {"if":{"properties":{"response_body_complete":{"const":true}},"required":["response_body_complete"]},"then":{"properties":{"metadata_response_observed":{"const":true},"response_headers_observed":{"const":true},"content_type":{"const":"application/json"},"response_sha256":{"$ref":"#/$defs/sha256"}}}},
    {"if":{"properties":{"reason_codes":{"items":{"enum":["DNS_LOOKUP_FAILED","TRANSPORT_FACTS_MISMATCH"]},"minItems":1}},"required":["reason_codes"]},"then":{"properties":{"resolved_address_count":{"const":0},"resolved_address_count_overflow":{"const":false},"all_resolved_addresses_global":{"const":false},"tls_certificate_verified":{"const":false},"connected_peer_in_resolved_set":{"const":false},"request_sent_count":{"const":0},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"reason_codes":{"items":{"enum":["CONNECTION_FAILED","TLS_VERIFICATION_FAILED"]},"minItems":1}},"required":["reason_codes"]},"then":{"properties":{"resolved_address_count":{"minimum":1},"all_resolved_addresses_global":{"const":true},"tls_certificate_verified":{"const":false},"request_sent_count":{"const":0}}}},
    {"if":{"properties":{"reason_codes":{"const":["CONNECTED_PEER_NOT_IN_RESOLVED_SET"]}},"required":["reason_codes"]},"then":{"properties":{"resolved_address_count":{"minimum":1},"all_resolved_addresses_global":{"const":true},"tls_certificate_verified":{"const":true},"connected_peer_in_resolved_set":{"const":false},"request_sent_count":{"const":0}}}},
    {"if":{"properties":{"reason_codes":{"const":["DNS_NON_GLOBAL_OR_AMBIGUOUS"]}},"required":["reason_codes"]},"then":{"properties":{"all_resolved_addresses_global":{"const":false},"tls_certificate_verified":{"const":false},"connected_peer_in_resolved_set":{"const":false},"request_send_state":{"const":"NOT_ATTEMPTED"},"request_sent_count":{"const":0},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"reason_codes":{"const":["REQUEST_SEND_FAILED"]}},"required":["reason_codes"]},"then":{"properties":{"resolved_address_count":{"minimum":1},"all_resolved_addresses_global":{"const":true},"tls_certificate_verified":{"const":true},"connected_peer_in_resolved_set":{"const":true},"request_send_state":{"const":"UNKNOWN_PARTIAL"},"request_sent_count":{"const":0},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"reason_codes":{"const":["RESPONSE_READ_FAILED"]}},"required":["reason_codes"]},"then":{"properties":{"resolved_address_count":{"minimum":1},"all_resolved_addresses_global":{"const":true},"tls_certificate_verified":{"const":true},"connected_peer_in_resolved_set":{"const":true},"request_send_state":{"const":"COMPLETE"},"request_sent_count":{"const":1},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"reason_codes":{"items":{"enum":["RESPONSE_HEADERS_BOUNDS_EXCEEDED","RESPONSE_HEADERS_MALFORMED"]},"minItems":1}},"required":["reason_codes"]},"then":{"properties":{"request_sent_count":{"const":1},"response_headers_observed":{"const":false},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"reason_codes":{"items":{"enum":["REDIRECT_REJECTED","HTTP_STATUS_REJECTED","CONTENT_TYPE_REJECTED","CONTENT_ENCODING_REJECTED","TRANSFER_ENCODING_REJECTED","CONTENT_LENGTH_REQUIRED","RESPONSE_BOUNDS_EXCEEDED"]},"minItems":1}},"required":["reason_codes"]},"then":{"properties":{"request_sent_count":{"const":1},"response_headers_observed":{"const":true},"response_body_complete":{"const":false}}}},
    {"if":{"properties":{"reason_codes":{"items":{"enum":["METADATA_JSON_MALFORMED","INFO_MALFORMED","DIGESTS_MALFORMED","CORE_METADATA_MALFORMED","PROJECT_IDENTITY_MISMATCH","VULNERABILITY_STATE_NOT_EMPTY","RELEASE_FILE_SET_MALFORMED","PIN_CANDIDATE_COUNT_MISMATCH","PIN_COORDINATE_MISMATCH","PIN_DIGEST_MISMATCH","METADATA_DIGEST_MISMATCH"]},"minItems":1}},"required":["reason_codes"]},"then":{"properties":{"response_body_complete":{"const":true}}}}
  ]
}
