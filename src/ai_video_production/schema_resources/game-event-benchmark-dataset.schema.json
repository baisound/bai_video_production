{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/game-event-benchmark-dataset.schema.json",
  "title": "TASK-049 Game Event Benchmark Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "revision",
    "kind",
    "cases",
    "dataset_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "SYNTHETIC",
        "HUMAN_GOLD"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_frame",
        "end_frame_exclusive"
      ],
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame_exclusive": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "source_ref",
        "expected_event_type",
        "expected_range",
        "expected_abstention",
        "labeler_ref",
        "evaluation_range"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expected_event_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "MATCH_START",
            "CHASE_START",
            "CHASE_END",
            "GENERATOR_COMPLETE",
            "INJURY",
            "DOWN",
            "HOOK",
            "UNHOOK",
            "WINDOW_VAULT",
            "PALLET_DROP",
            "KILL",
            "ESCAPE",
            "UNKNOWN_EVENT",
            null
          ]
        },
        "expected_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/frameRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_abstention": {
          "type": "boolean"
        },
        "labeler_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "evaluation_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/frameRange"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
