      "then": {"properties": {"receipts": {"properties": {"quick_clone": {"type": "object", "properties": {"producer_state": {"const": "ACCEPTED"}}}, "listening_join": {"type": "object", "properties": {"producer_state": {"const": "ACCEPTED"}}}}}}}
    },
    {
