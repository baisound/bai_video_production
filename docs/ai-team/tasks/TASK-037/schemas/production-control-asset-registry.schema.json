{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bai-video-production://task-037/production-control-asset-registry.schema.json",
  "title": "TASK-037 Production Control Asset Registry Contract Draft",
  "type": "object",
  "required": ["contract_version", "scene_asset_slots", "asset_candidates", "dependency_edges"],
  "properties": {
    "contract_version": {"const": "0.9.0-draft"},
    "scene_asset_slots": {"type": "array", "items": {"$ref": "#/$defs/SceneAssetSlot"}},
    "asset_candidates": {"type": "array", "items": {"$ref": "#/$defs/AssetCandidate"}},
    "dependency_edges": {"type": "array", "items": {"$ref": "#/$defs/DependencyEdge"}}
  },
  "additionalProperties": false,
  "$defs": {
    "NonEmptyId": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "Sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "SceneAssetSlot": {
      "type": "object",
      "required": ["slot_id", "project_id", "scene_id", "slot_kind", "required", "status", "locked_candidate_id", "stale_state", "revision"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/NonEmptyId"},
        "project_id": {"$ref": "#/$defs/NonEmptyId"},
        "scene_id": {"$ref": "#/$defs/NonEmptyId"},
        "slot_kind": {"enum": ["START_FRAME", "END_FRAME", "VIDEO", "VFX", "SE", "BGM", "NARRATION", "OTHER"]},
        "required": {"type": "boolean"},
        "status": {"enum": ["EMPTY", "CANDIDATES_AVAILABLE", "ACCEPTED", "LOCKED", "STALE"]},
        "locked_candidate_id": {"anyOf": [{"$ref": "#/$defs/NonEmptyId"}, {"type": "null"}]},
        "stale_state": {"enum": ["CURRENT", "STALE"]},
        "stale_root_cause_ref": {"anyOf": [{"$ref": "#/$defs/NonEmptyId"}, {"type": "null"}]},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "AssetCandidate": {
      "type": "object",
      "required": ["candidate_id", "slot_id", "asset_id", "asset_sha256", "candidate_version", "lifecycle_state"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/NonEmptyId"},
        "slot_id": {"$ref": "#/$defs/NonEmptyId"},
        "asset_id": {"$ref": "#/$defs/NonEmptyId"},
        "asset_sha256": {"$ref": "#/$defs/Sha256"},
        "generation_job_id": {"anyOf": [{"$ref": "#/$defs/NonEmptyId"}, {"type": "null"}]},
        "parent_candidate_id": {"anyOf": [{"$ref": "#/$defs/NonEmptyId"}, {"type": "null"}]},
        "candidate_version": {"type": "integer", "minimum": 1},
        "lifecycle_state": {"enum": ["CREATED", "READY_FOR_AUDIT", "ACCEPTED", "REJECTED", "ALTERNATE_USE", "LOCKED", "STALE"]},
        "supersedes": {"anyOf": [{"$ref": "#/$defs/NonEmptyId"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "DependencyEdge": {
      "type": "object",
      "required": ["edge_id", "from_entity_type", "from_entity_id", "to_entity_type", "to_entity_id", "dependency_kind"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/NonEmptyId"},
        "from_entity_type": {"enum": ["PLAN", "SCENE", "SLOT", "CANDIDATE", "ASSET", "CONTRACT", "PROMPT"]},
        "from_entity_id": {"$ref": "#/$defs/NonEmptyId"},
        "from_hash": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "to_entity_type": {"enum": ["SCENE", "SLOT", "CANDIDATE", "ASSET", "CONTRACT", "PROMPT"]},
        "to_entity_id": {"$ref": "#/$defs/NonEmptyId"},
        "dependency_kind": {"enum": ["USES", "DERIVED_FROM", "CONTINUITY", "GENERATED_FROM", "AUDITED_AGAINST"]},
        "continuity_boundary": {"enum": ["DIRECT_CONTINUATION", "SOFT_CONTINUITY", "DISCONTINUOUS", null]}
      },
      "additionalProperties": false
    }
  }
}
