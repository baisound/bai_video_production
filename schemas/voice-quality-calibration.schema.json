        "production_admission": {"const": false}, "calibration_session_revision_sha256": {"$ref": "#/$defs/sha256"}
      }}], "unevaluatedProperties": false
    },
    "measurementInputRangeBinding": {
      "allOf": [
        {"$ref": "#/$defs/commonRevision"},
        {"type": "object", "required": ["measurement_input_range_id", "source_class", "processing_class", "sample_rate", "bit_depth", "channels", "interval", "canonical_mapping_sha256", "capture_chain_revision_sha256", "source_binding", "measurement_input_range_binding_sha256"], "properties": {
          "record_type": {"const": "MeasurementInputRangeBinding"}, "measurement_input_range_id": {"$ref": "#/$defs/id"},
          "source_class": {"enum": ["CALIBRATION_STAGING_EVIDENCE", "TASK003_ASSET_REVISION"]}, "processing_class": {"$ref": "#/$defs/processingClass"},
          "sample_rate": {"const": 48000}, "bit_depth": {"const": 24}, "channels": {"const": 1}, "interval": {"$ref": "#/$defs/halfOpenSampleInterval"},
          "canonical_mapping_sha256": {"$ref": "#/$defs/sha256"}, "capture_chain_revision_sha256": {"$ref": "#/$defs/sha256"},
          "source_binding": {"oneOf": [{"$ref": "#/$defs/calibrationStagingObjectBinding"}, {"$ref": "#/$defs/task003AssetBinding"}]},
          "measurement_input_range_binding_sha256": {"$ref": "#/$defs/sha256"}
        }},
        {"if": {"properties": {"source_class": {"const": "CALIBRATION_STAGING_EVIDENCE"}}}, "then": {"properties": {"source_binding": {"$ref": "#/$defs/calibrationStagingObjectBinding"}}}, "else": {"properties": {"source_binding": {"$ref": "#/$defs/task003AssetBinding"}}}}
      ], "unevaluatedProperties": false
    },
    "stagingToTask003AssetPromotionBinding": {
      "allOf": [{"$ref": "#/$defs/commonRevision"}, {"type": "object", "required": ["promotion_binding_id", "contract_state", "staging_input_range_sha256", "asset_mapping_ref", "asset_mapping_sha256", "owner_decision_ref", "owner_decision_sha256", "effect_receipt_ref", "effect_receipt_sha256", "source_object_state_mutated", "effect_issued_by_pqc", "staging_to_task003_asset_promotion_binding_sha256"], "properties": {
        "record_type": {"const": "StagingToTask003AssetPromotionBinding"}, "promotion_binding_id": {"$ref": "#/$defs/id"}, "contract_state": {"$ref": "#/$defs/contractState"},
        "staging_input_range_sha256": {"$ref": "#/$defs/nullableSha256"}, "asset_mapping_ref": {"$ref": "#/$defs/nullableId"}, "asset_mapping_sha256": {"$ref": "#/$defs/nullableSha256"},
        "owner_decision_ref": {"$ref": "#/$defs/nullableId"}, "owner_decision_sha256": {"$ref": "#/$defs/nullableSha256"}, "effect_receipt_ref": {"$ref": "#/$defs/nullableId"}, "effect_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "source_object_state_mutated": {"const": false}, "effect_issued_by_pqc": {"const": false}, "staging_to_task003_asset_promotion_binding_sha256": {"$ref": "#/$defs/sha256"}
      }}, {"if": {"properties": {"contract_state": {"const": "CANONICAL_REF_NOT_PROVIDED"}}}, "then": {"properties": {
        "staging_input_range_sha256": {"type": "null"}, "asset_mapping_ref": {"type": "null"}, "asset_mapping_sha256": {"type": "null"},
        "owner_decision_ref": {"type": "null"}, "owner_decision_sha256": {"type": "null"}, "effect_receipt_ref": {"type": "null"}, "effect_receipt_sha256": {"type": "null"}
      }}}, {"if": {"properties": {"contract_state": {"const": "BOUND_VERIFIED"}}}, "then": {"properties": {
        "staging_input_range_sha256": {"$ref": "#/$defs/sha256"}, "asset_mapping_ref": {"$ref": "#/$defs/id"}, "asset_mapping_sha256": {"$ref": "#/$defs/sha256"},
        "owner_decision_ref": {"$ref": "#/$defs/id"}, "owner_decision_sha256": {"$ref": "#/$defs/sha256"}, "effect_receipt_ref": {"$ref": "#/$defs/id"}, "effect_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }}}], "unevaluatedProperties": false
    },
    "metricInputSetBinding": {
