        ,{"if": {"properties": {"decision": {"const": "APPENDED"}}, "required": ["decision"]}, "then": {"properties": {"reason_codes": {"enum": [["NO_REPLACE_APPEND_OBSERVED"], ["RECOVERED_NO_REPLACE_APPEND_OBSERVED"]]}, "pending_state": {"const": "NONE"}}}}
