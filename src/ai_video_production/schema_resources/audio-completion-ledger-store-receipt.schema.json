        ,{"if": {"properties": {"pending_state": {"const": "RECOVERABLE"}}, "required": ["pending_state"]}, "then": {"properties": {"pending_count": {"minimum": 1}, "pending_disk_bytes": {"minimum": 1}}}}
        ,{"if": {"properties": {"content_state": {"enum": ["PENDING_VERIFIED", "BOTH_IDENTICAL"]}}, "required": ["content_state"]}, "then": {"properties": {"pending_count": {"minimum": 1}, "pending_disk_bytes": {"minimum": 1}}}}
