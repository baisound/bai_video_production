    },
    {
      "if": {"properties": {"receipts": {"properties": {"inference": {"not": {"type": "null"}}}}}},
      "then": {"properties": {"receipts": {"properties": {"durable_job": {"not": {"type": "null"}}}}}}
    },
    {
      "if": {"properties": {"receipts": {"properties": {"wav": {"not": {"type": "null"}}}}}},
