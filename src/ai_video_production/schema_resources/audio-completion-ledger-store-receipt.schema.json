        ,{"if": {"properties": {"decision": {"const": "NOT_COMMITTED"}}, "required": ["decision"]}, "then": {"properties": {"operation": {"const": "INSPECT_PENDING"}, "rename_state": {"const": "NOT_ATTEMPTED"}, "namespace_state": {"const": "NEITHER"}, "content_state": {"const": "NOT_OBSERVED"}, "pending_state": {"const": "STALE"}, "resource_observation_state": {"const": "NOT_OBSERVED"}, "chain_state": {"const": "VALID"}, "lock_acquired": {"const": true}, "filesystem_read_attempted": {"const": true}, "filesystem_read_observed": {"const": true}, "filesystem_write_attempted": {"const": false}, "filesystem_write_observed": {"const": false}}}}
        ,{"if": {"properties": {"decision": {"enum": ["OBSERVED", "APPENDED", "ALREADY_COMMITTED_RECONCILED", "RECOVERY_AVAILABLE", "NOT_COMMITTED"]}}, "required": ["decision"]}, "then": {"properties": {"resource_release_state": {"const": "RELEASE_CONFIRMED"}, "lock_release_confirmed": {"const": true}, "unreleased_handle_count": {"const": 0}, "unreleased_native_allocation_count": {"const": 0}}}}
