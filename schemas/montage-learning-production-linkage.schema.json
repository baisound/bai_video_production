        "canonical_timeline": { "const": false },
        "auto_apply_authorized": { "const": false },
        "durable_readback_verified": { "const": true },
        "authority_created": { "const": false }
      }
    },
    "PreactivationChainFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "phase",
        "evidence_mode",
        "task072_design_sha256",
        "fixture_only",
        "native_broker_executed",
        "plan_sha256",
        "operation_id",
        "install_instance_id",
        "task036_completion_receipt_sha256",
        "task061b_completion_receipt_sha256",
        "adapter_stage",
        "task036_import",
        "public_receipt",
        "hidden_correlation",
        "canonical_readback",
        "profile_readback",
        "evidence_complete",
        "authority_created"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "message_type": { "const": "Task065PreactivationChainFixture" },
        "phase": { "const": "PREACTIVATION" },
        "evidence_mode": { "const": "SYNTHETIC_PUBLIC_SAFE_FIXTURE" },
        "task072_design_sha256": { "const": "sha256:4f6f21e97d96aa3ffca16f57679abf80d081de6d85d599347fd955c8899ce3c7" },
        "fixture_only": { "const": true },
        "native_broker_executed": { "const": false },
        "plan_sha256": { "$ref": "#/$defs/Sha256" },
        "operation_id": { "$ref": "#/$defs/OperationId" },
        "install_instance_id": { "$ref": "#/$defs/InstallInstanceId" },
        "task036_completion_receipt_sha256": { "$ref": "#/$defs/Sha256" },
        "task061b_completion_receipt_sha256": { "$ref": "#/$defs/Sha256" },
        "adapter_stage": { "$ref": "#/$defs/AdapterStage" },
        "task036_import": { "$ref": "#/$defs/Task036Import" },
        "public_receipt": { "$ref": "#/$defs/PublicReceipt" },
        "hidden_correlation": { "$ref": "#/$defs/HiddenCorrelation" },
        "canonical_readback": { "$ref": "#/$defs/CanonicalReadback" },
        "profile_readback": { "$ref": "#/$defs/ProfileReadback" },
        "evidence_complete": { "const": true },
        "authority_created": { "const": false }
      }
