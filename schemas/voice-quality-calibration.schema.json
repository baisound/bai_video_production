        "record_type": {"const": "MetricInputSetBinding"}, "metric_input_set_id": {"$ref": "#/$defs/id"}, "input_kind": {"enum": ["SINGLE_RANGE", "ORDERED_MULTI_RANGE", "PAIRED_BEFORE_AFTER"]}, "purpose": {"$ref": "#/$defs/id"},
        "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metricInputReference"}}, "analyzer_profile_revision_sha256": {"$ref": "#/$defs/sha256"},
        "calibration_profile_revision_sha256": {"$ref": "#/$defs/sha256"}, "quality_policy_revision_sha256": {"$ref": "#/$defs/sha256"}, "compatibility_state": {"$ref": "#/$defs/qualityState"},
        "metric_input_set_binding_sha256": {"$ref": "#/$defs/sha256"}
