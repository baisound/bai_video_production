{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/premiere-fcp7-xml-package.schema.json",
  "title": "TASK-025 Premiere FCP7 XML Package Receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "frameRate": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 }
      },
      "required": ["numerator", "denominator"]
    }
  },
  "properties": {
    "package_version": { "const": "1.0.0" },
    "task_owner": { "const": "TASK-025" },
    "format": { "const": "FCP7_XMEML_V5" },
    "sequence_profile": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sequence_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,127}$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "frame_rate": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "type": "integer", "minimum": 1 },
            "fcp_timebase": { "enum": [24, 25, 30, 50, 60] },
            "ntsc": { "type": "boolean" }
          },
          "required": ["numerator", "denominator", "fcp_timebase", "ntsc"]
        },
        "pixel_aspect_ratio": { "enum": ["square", "PAL-CCIR-601", "NTSC-CCIR-601"] }
      },
      "required": ["sequence_name", "width", "height", "frame_rate", "pixel_aspect_ratio"]
    },
    "timeline_plan_sha256": { "$ref": "#/$defs/sha256" },
    "media_binding_receipts": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "asset_id": { "type": "string", "pattern": "^ASSET-[0-9A-HJKMNP-TV-Z]{26}$" },
          "asset_sha256": { "$ref": "#/$defs/sha256" },
          "logical_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,127}$" },
          "media_uri_sha256": { "$ref": "#/$defs/sha256" },
          "frame_rate": { "$ref": "#/$defs/frameRate" },
          "duration_frames": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "media_uri_public": { "const": false }
        },
        "required": [
          "asset_id", "asset_sha256", "logical_name", "media_uri_sha256", "frame_rate",
          "duration_frames", "media_uri_public"
        ]
      }
    },
    "xml_byte_length": { "type": "integer", "minimum": 1 },
    "xml_sha256": { "$ref": "#/$defs/sha256" },
    "media_uri_values_private": { "const": true },
    "media_read_performed": { "const": false },
    "filesystem_write_performed": { "const": false },
    "premiere_import_performed": { "const": false },
    "external_mutation_authorized": { "const": false },
    "human_import_review_required": { "const": true },
    "package_sha256": { "$ref": "#/$defs/sha256" }
  },
  "required": [
    "package_version", "task_owner", "format", "sequence_profile", "timeline_plan_sha256",
    "media_binding_receipts", "xml_byte_length", "xml_sha256", "media_uri_values_private",
    "media_read_performed", "filesystem_write_performed", "premiere_import_performed",
    "external_mutation_authorized", "human_import_review_required", "package_sha256"
  ]
}
