{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baisound/bai_video_production/schemas/audio-media-review-history.schema.json",
  "title": "TASK-041 Audio Media Review History",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version", "task_owner", "project_id", "store_revision", "entries",
    "audio_body_embedded", "playback_authority", "media_mutation_authority",
    "external_execution_authority", "snapshot_sha256"
  ],
  "properties": {
    "snapshot_version": {"const": "1.0.0"},
    "task_owner": {"const": "TASK-041"},
    "project_id": {"$ref": "#/$defs/id"},
    "store_revision": {"type": "integer", "minimum": 0, "maximum": 10000},
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/entry"}
    },
    "audio_body_embedded": {"const": false},
    "playback_authority": {"const": false},
    "media_mutation_authority": {"const": false},
    "external_execution_authority": {"const": false},
    "snapshot_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_binding", "capability_binding", "review_intent",
        "external_review_receipt", "derived_asset_proposal", "review_decision",
        "entry_sha256"
      ],
      "properties": {
        "source_binding": {
          "$ref": "https://bai.local/schemas/audio-workspace-media-review.schema.json#/$defs/AudioMediaSourceBinding"
        },
        "capability_binding": {
          "$ref": "https://bai.local/schemas/audio-workspace-media-review.schema.json#/$defs/PlaybackWaveformCapabilityBinding"
        },
        "review_intent": {
          "$ref": "https://bai.local/schemas/audio-workspace-media-review.schema.json#/$defs/AudioMediaReviewIntent"
        },
        "external_review_receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://bai.local/schemas/audio-workspace-media-review.schema.json#/$defs/ExternalAudioReviewReceiptBinding"}
          ]
        },
        "derived_asset_proposal": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://bai.local/schemas/audio-workspace-media-review.schema.json#/$defs/DerivedAudioAssetProposal"}
          ]
        },
        "review_decision": {
          "$ref": "https://bai.local/schemas/audio-workspace-media-review.schema.json#/$defs/AudioMediaReviewDecision"
        },
        "entry_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
