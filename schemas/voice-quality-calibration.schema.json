      "allOf": [
        {"if": {"properties": {"contract_state": {"const": "CANONICAL_REF_NOT_PROVIDED"}}}, "then": {"properties": {
          "asset_id": {"type": "null"}, "asset_checksum_sha256": {"type": "null"},
          "asset_record_evidence_sha256": {"type": "null"}, "asset_revision_binding_ref": {"type": "null"},
          "asset_revision_binding_sha256": {"type": "null"}, "official_mapping_state": {"const": "UNBOUND_PENDING_TASK003"}
        }}},
        {"if": {"properties": {"contract_state": {"const": "BOUND_VERIFIED"}}}, "then": {"properties": {
          "asset_id": {"$ref": "#/$defs/id"}, "asset_checksum_sha256": {"$ref": "#/$defs/sha256"},
          "asset_record_evidence_sha256": {"$ref": "#/$defs/sha256"}, "asset_revision_binding_ref": {"$ref": "#/$defs/id"},
          "asset_revision_binding_sha256": {"$ref": "#/$defs/sha256"}, "official_mapping_state": {"const": "BOUND"}
        }}}
      ]
    },
    "captureChainRevision": {
      "allOf": [
        {"$ref": "#/$defs/commonRevision"},
        {"type": "object", "required": ["capture_chain_id", "sample_rate", "bit_depth", "channels", "stages", "calibration_state", "human_input_binding_sha256", "capture_chain_revision_sha256"], "properties": {
          "record_type": {"const": "CaptureChainRevision"}, "capture_chain_id": {"$ref": "#/$defs/id"},
          "sample_rate": {"const": 48000}, "bit_depth": {"const": 24}, "channels": {"const": 1},
          "stages": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/captureChainStage"}},
          "calibration_state": {"$ref": "#/$defs/qualityState"}, "human_input_binding_sha256": {"$ref": "#/$defs/sha256"},
          "capture_chain_revision_sha256": {"$ref": "#/$defs/sha256"}
        }}
      ], "unevaluatedProperties": false
    },
    "calibrationProfileRevision": {
      "allOf": [{"$ref": "#/$defs/commonRevision"}, {"type": "object", "required": ["calibration_profile_id", "capture_chain_revision_sha256", "scenario", "processing_class", "sample_rate", "bit_depth", "channels", "policy_scope", "calibration_profile_revision_sha256"], "properties": {
        "record_type": {"const": "CalibrationProfileRevision"}, "calibration_profile_id": {"$ref": "#/$defs/id"}, "capture_chain_revision_sha256": {"$ref": "#/$defs/sha256"},
        "scenario": {"enum": ["ROOM_TONE", "NORMAL_VOICE", "LOUD_VOICE", "WHISPER", "SOFT_WHISPER", "NORMAL_INTERMEDIATE"]}, "processing_class": {"$ref": "#/$defs/processingClass"},
        "sample_rate": {"const": 48000}, "bit_depth": {"const": 24}, "channels": {"const": 1}, "policy_scope": {"$ref": "#/$defs/id"}, "calibration_profile_revision_sha256": {"$ref": "#/$defs/sha256"}
      }}], "unevaluatedProperties": false
    },
    "qualityPolicyRevision": {
      "allOf": [{"$ref": "#/$defs/commonRevision"}, {"type": "object", "required": ["quality_policy_id", "use_case_scope", "metric_rules_sha256", "precedence_rule", "conflict_rule", "percentage_policy_state", "target_percentage_basis_points", "privacy_policy_binding_sha256", "default_valid_decision", "quality_policy_revision_sha256"], "properties": {
        "record_type": {"const": "QualityPolicyRevision"}, "quality_policy_id": {"$ref": "#/$defs/id"}, "use_case_scope": {"enum": ["NARRATION_RECORDING", "TRAINING_SOURCE", "PUBLISHED_PROGRAMME", "MODEL_EVALUATION"]},
        "metric_rules_sha256": {"$ref": "#/$defs/sha256"}, "precedence_rule": {"enum": ["EXACT_CURRENT_ONLY", "EXPLICIT_ORDER", "UNKNOWN"]}, "conflict_rule": {"enum": ["FAIL_WINS", "EXPLICIT_PRECEDENCE", "UNKNOWN"]},
        "percentage_policy_state": {"$ref": "#/$defs/contractState"}, "target_percentage_basis_points": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 10000}]},
        "privacy_policy_binding_sha256": {"$ref": "#/$defs/sha256"}, "default_valid_decision": {"$ref": "#/$defs/qualityState"}, "quality_policy_revision_sha256": {"$ref": "#/$defs/sha256"}
      }}, {"if": {"properties": {"percentage_policy_state": {"const": "BOUND_VERIFIED"}}}, "then": {"properties": {"target_percentage_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}}}, "else": {"properties": {"target_percentage_basis_points": {"type": "null"}}}}], "unevaluatedProperties": false
    },
    "analyzerProfileRevision": {
      "allOf": [{"$ref": "#/$defs/commonRevision"}, {"type": "object", "required": ["analyzer_profile_id", "analyzer_name", "analyzer_version", "code_sha256", "supported_metrics", "capability_evidence_sha256", "contract_state", "analyzer_profile_revision_sha256"], "properties": {
        "record_type": {"const": "AnalyzerProfileRevision"}, "analyzer_profile_id": {"$ref": "#/$defs/id"}, "analyzer_name": {"$ref": "#/$defs/id"}, "analyzer_version": {"$ref": "#/$defs/id"},
        "code_sha256": {"$ref": "#/$defs/sha256"}, "supported_metrics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "capability_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "contract_state": {"$ref": "#/$defs/contractState"}, "analyzer_profile_revision_sha256": {"$ref": "#/$defs/sha256"}
      }}], "unevaluatedProperties": false
    },
    "calibrationSessionRevision": {
      "allOf": [{"$ref": "#/$defs/commonRevision"}, {"type": "object", "required": ["calibration_session_id", "state", "capture_chain_revision_sha256", "calibration_profile_revision_sha256", "quality_policy_revision_sha256", "analyzer_profile_revision_sha256", "human_input_binding_sha256", "capture_evidence_binding_sha256", "production_admission", "calibration_session_revision_sha256"], "properties": {
        "record_type": {"const": "CalibrationSessionRevision"}, "calibration_session_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["DRAFT", "PREFLIGHT_PENDING", "BLOCKED", "READY_FOR_HUMAN_GATE", "MEASUREMENT_PENDING", "MEASURED", "FAILED_KNOWN", "UNKNOWN", "CANCELLED_SAFE"]},
        "capture_chain_revision_sha256": {"$ref": "#/$defs/sha256"}, "calibration_profile_revision_sha256": {"$ref": "#/$defs/sha256"}, "quality_policy_revision_sha256": {"$ref": "#/$defs/sha256"},
