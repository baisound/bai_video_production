{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.local/schemas/montage-preference-profile.schema.json",
  "title": "TASK-055 Advisory Montage Preference Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version_contract",
    "task_owner",
    "future_generic_learning_owner",
    "future_holdout_promotion_owner",
    "profile_id",
    "profile_version",
    "source_evidence_sha256s",
    "minimum_samples",
    "timing_preferences",
    "advisory_only",
    "human_review_required_before_use",
    "automatic_profile_write_authorized",
    "automatic_edit_plan_mutation_authorized",
    "automatic_promotion_authorized",
    "profile_sha256"
  ],
  "properties": {
    "profile_version_contract": {
      "const": "1.0.0"
    },
    "task_owner": {
      "const": "TASK-055"
    },
    "future_generic_learning_owner": {
      "const": "TASK-029"
    },
    "future_holdout_promotion_owner": {
      "const": "TASK-019"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "profile_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_evidence_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "minimum_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "timing_preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "style_profile_id",
          "event_type",
          "music_anchor_kind",
          "sample_count",
          "retained_count",
          "moved_count",
          "deleted_count",
          "accepted_rate_milli",
          "median_delta_frames",
          "mean_delta_milli_frames",
          "state"
        ],
        "properties": {
          "style_profile_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "event_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
          },
          "music_anchor_kind": {
            "enum": [
              "BEAT",
              "DOWNBEAT",
              "PHRASE_HEAD",
              "BUILD",
              "DROP",
              "BREAKDOWN",
              "MICRO_PAUSE",
              "OUTRO"
            ]
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1
          },
          "retained_count": {
            "type": "integer",
            "minimum": 0
          },
          "moved_count": {
            "type": "integer",
            "minimum": 0
          },
          "deleted_count": {
            "type": "integer",
            "minimum": 0
          },
          "accepted_rate_milli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "median_delta_frames": {
            "type": [
              "integer",
              "null"
            ]
          },
          "mean_delta_milli_frames": {
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "enum": [
              "INSUFFICIENT_DATA",
              "ADVISORY_READY_FOR_HUMAN_REVIEW"
            ]
          }
        }
      }
    },
    "advisory_only": {
      "const": true
    },
    "human_review_required_before_use": {
      "const": true
    },
    "automatic_profile_write_authorized": {
      "const": false
    },
    "automatic_edit_plan_mutation_authorized": {
      "const": false
    },
    "automatic_promotion_authorized": {
      "const": false
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
