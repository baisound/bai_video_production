{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/dbd-reasoning-candidate-lineage.schema.json",
  "title": "TASK-054 DbD Reasoning Candidate Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_kind","origin","candidate_id","commentary_candidate_sha256","match_id","event_id","event_revision","parser_version","raw_output_sha256","structural_body_sha256","context_sha256","commentary_plan_sha256","fact_admission_receipt","policy_admission_receipt","proposal","parent_candidate_id","parent_candidate_sha256","correction_request_review_sha256","lineage_sha256"],
  "properties": {
    "schema_version":{"const":"1.0.0"},"record_kind":{"const":"DBD_REASONING_CANDIDATE_LINEAGE"},"origin":{"const":"TUNED_REASONING"},
    "candidate_id":{"type":"string","pattern":"^CAND-R2D[0-9A-HJKMNP-TV-Z]{23}$"},"commentary_candidate_sha256":{"$ref":"#/$defs/sha"},
    "match_id":{"type":"string","pattern":"^MATCH-[0-9A-HJKMNP-TV-Z]{26}$"},"event_id":{"type":"string","pattern":"^GEVT-[0-9A-HJKMNP-TV-Z]{26}$"},"event_revision":{"type":"integer","minimum":1},
    "parser_version":{"const":"2.0.0"},"raw_output_sha256":{"$ref":"#/$defs/sha"},"structural_body_sha256":{"$ref":"#/$defs/sha"},"context_sha256":{"$ref":"#/$defs/sha"},"commentary_plan_sha256":{"$ref":"#/$defs/sha"},
    "fact_admission_receipt":{"$ref":"#/$defs/factReceipt"},"policy_admission_receipt":{"$ref":"#/$defs/policyReceipt"},"proposal":{"$ref":"#/$defs/proposal"},
    "parent_candidate_id":{"type":"null"},"parent_candidate_sha256":{"type":"null"},"correction_request_review_sha256":{"type":"null"},"lineage_sha256":{"$ref":"#/$defs/sha"}
  },
  "$defs": {
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "safeRef":{"type":"string","minLength":4,"maxLength":512,"pattern":"^[A-Za-z][A-Za-z0-9+.-]*://[^\\s\\\\@?#]+$"},
    "codes":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"}},
    "factReceipt":{"type":"object","additionalProperties":false,"required":["schema_version","structural_body_sha256","context_sha256","commentary_plan_sha256","commentary_draft_sha256","passed","error_codes","receipt_sha256"],"properties":{"schema_version":{"const":"1.0.0"},"structural_body_sha256":{"$ref":"#/$defs/sha"},"context_sha256":{"$ref":"#/$defs/sha"},"commentary_plan_sha256":{"$ref":"#/$defs/sha"},"commentary_draft_sha256":{"$ref":"#/$defs/sha"},"passed":{"const":true},"error_codes":{"$ref":"#/$defs/codes","maxItems":0},"receipt_sha256":{"$ref":"#/$defs/sha"}}},
    "policyReceipt":{"type":"object","additionalProperties":false,"required":["schema_version","policy_version","structural_body_sha256","context_sha256","commentary_plan_sha256","fact_admission_receipt_sha256","reference_snapshot_sha256","proposal_sha256","passed","error_codes","receipt_sha256"],"properties":{"schema_version":{"const":"1.0.0"},"policy_version":{"const":"1.0.0"},"structural_body_sha256":{"$ref":"#/$defs/sha"},"context_sha256":{"$ref":"#/$defs/sha"},"commentary_plan_sha256":{"$ref":"#/$defs/sha"},"fact_admission_receipt_sha256":{"$ref":"#/$defs/sha"},"reference_snapshot_sha256":{"$ref":"#/$defs/sha"},"proposal_sha256":{"$ref":"#/$defs/sha"},"passed":{"const":true},"error_codes":{"$ref":"#/$defs/codes","maxItems":0},"receipt_sha256":{"$ref":"#/$defs/sha"}}},
    "fact":{"type":"object","additionalProperties":false,"required":["kind","key","value"],"properties":{"kind":{"enum":["EVENT_OCCURRED","PERK_NAME","PERK_EFFECT","PERK_ACTIVATION","KILLER_NAME","KILLER_DESCRIPTION","POWER_NAME","POWER_DESCRIPTION","TRIVIA"]},"key":{"type":"string","minLength":1,"maxLength":256},"value":{"type":"string","minLength":1,"maxLength":4096}}},
    "inference":{"type":"object","additionalProperties":false,"required":["statement","qualifier","confidence_milli","supporting_refs"],"properties":{"statement":{"type":"string","minLength":1,"maxLength":1000},"qualifier":{"enum":["POSSIBLE","LIKELY"]},"confidence_milli":{"type":"integer","minimum":0,"maximum":1000},"supporting_refs":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/safeRef"}}}},
    "style":{"type":"object","additionalProperties":false,"required":["density_milli","emotion_milli","tempo_milli"],"properties":{"density_milli":{"type":"integer","minimum":0,"maximum":1000},"emotion_milli":{"type":"integer","minimum":0,"maximum":1000},"tempo_milli":{"type":"integer","minimum":0,"maximum":1000}}},
    "proposal":{"type":"object","additionalProperties":false,"required":["schema_version","disposition","observed_claims","canonical_claims","inferred_states","tactical_interpretations","commentary_outline","commentary_text","citations","uncertainty_codes","style_metrics","proposal_sha256"],"properties":{"schema_version":{"const":"1.0.0"},"disposition":{"const":"PROPOSE"},"observed_claims":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/fact"}},"canonical_claims":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/fact"}},"inferred_states":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/inference"}},"tactical_interpretations":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/inference"}},"commentary_outline":{"type":"array","maxItems":16,"items":{"type":"string","minLength":1,"maxLength":500}},"commentary_text":{"type":"string","minLength":1,"maxLength":8000},"citations":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/safeRef"}},"uncertainty_codes":{"$ref":"#/$defs/codes"},"style_metrics":{"$ref":"#/$defs/style"},"proposal_sha256":{"$ref":"#/$defs/sha"}}}
  }
}
