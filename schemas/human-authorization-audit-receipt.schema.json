{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.example/schemas/human-authorization-audit-receipt.schema.json",
  "title": "TASK-071 Effect-zero Human Authorization Audit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "audit_receipt_id", "reservation_id", "reservation_sha256", "decision_event_id", "decision_event_sha256", "action", "outcome", "authority_created", "effect_performed", "native_user_presence_verified"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "HUMAN_AUTHORIZATION_AUDIT_RECEIPT_V1"},
    "audit_receipt_id": {"type": "string", "minLength": 37, "maxLength": 37, "pattern": "^harc-[0-9a-f]{32}$"},
    "reservation_id": {"type": "string", "minLength": 36, "maxLength": 36, "pattern": "^har-[0-9a-f]{32}$"},
    "reservation_sha256": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_event_id": {"type": "string", "minLength": 36, "maxLength": 36, "pattern": "^hde-[0-9a-f]{32}$"},
    "decision_event_sha256": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "action": {"enum": ["PREFERENCE_PROMOTE", "PREFERENCE_ROLLBACK", "CONNECTOR_ACTIVATE", "CONNECTOR_DEACTIVATE"]},
    "outcome": {"enum": ["AUDIT_ONLY", "REJECTED", "EXPIRED", "REPLAY_REJECTED"]},
    "authority_created": {"const": false},
    "effect_performed": {"const": false},
    "native_user_presence_verified": {"const": false}
  }
}
