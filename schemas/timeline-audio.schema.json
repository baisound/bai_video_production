{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baisound/bai_video_production/schemas/timeline-audio.schema.json",
  "title": "BAI Video Production Timeline Audio History",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_version", "task_owner", "project_id", "plans", "current_plan_id", "current_revision", "script_bodies_embedded", "media_bytes_embedded", "provider_execution_authority", "snapshot_sha256"],
  "properties": {
    "snapshot_version": {"const": "1.0.0"},
    "task_owner": {"const": "TASK-042/P-V6-4"},
    "project_id": {"$ref": "#/$defs/id"},
    "plans": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/plan"}},
    "current_plan_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "current_revision": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "script_bodies_embedded": {"const": false},
    "media_bytes_embedded": {"const": false},
    "provider_execution_authority": {"const": false},
    "snapshot_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "source_intent", "candidate_id", "asset_id", "asset_sha256", "source_duration_frames"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"},
        "source_intent": {"enum": ["IMPORTED", "EXISTING_ASSET", "GENERATION_INTENT"]},
        "candidate_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "asset_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "asset_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
        "source_duration_frames": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
      }
    },
    "item": {
      "type": "object",
      "required": ["item_kind", "item_id", "role", "lane_id", "start_frame", "end_frame", "source", "item_sha256"],
      "properties": {
        "item_kind": {"enum": ["MUSIC_PLAN", "NARRATION_CUE", "AUDIO_CUE", "AUDIO_RANGE"]},
        "item_id": {"$ref": "#/$defs/id"}, "role": {"enum": ["NARRATION", "SE", "BGM", "AMBIENCE"]},
        "lane_id": {"$ref": "#/$defs/id"}, "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 1}, "source": {"$ref": "#/$defs/source"},
        "fit_policy": {"enum": ["EXACT", "TRIM", "LOOP", "STRETCH"]},
        "fade_in_frames": {"type": "integer", "minimum": 0}, "fade_out_frames": {"type": "integer", "minimum": 0},
        "gain_db": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": -120, "maximum": 24}]},
        "whole_timeline": {"type": "boolean"}, "transition_group_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "scene_id": {"$ref": "#/$defs/id"}, "text_ref": {"type": "string", "pattern": "^(bai-text|project)://"},
        "text_sha256": {"$ref": "#/$defs/sha"}, "text_body_persisted": {"const": false},
        "origin": {"enum": ["SCENE_PROPOSAL", "TASK014_ALIGNMENT", "SRT_IMPORT", "HUMAN"]},
        "proposal_state": {"enum": ["READY", "CONFLICT"]}, "conflict_codes": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "duration_frames": {"type": "integer", "minimum": 1}, "item_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["timeline_audio_plan_version", "task_owner", "project_id", "plan_id", "revision", "previous_plan_sha256", "blueprint_id", "blueprint_sha256", "timeline_rate", "target_duration_frames", "items", "timeline_frames_authoritative", "srt_timing_authoritative", "provider_execution_started", "candidate_mutation_started", "task026_compile_started", "resolve_mutation_started", "cubase_mutation_started", "plan_sha256"],
      "properties": {
        "timeline_audio_plan_version": {"const": "1.0.0"}, "task_owner": {"const": "TASK-042/P-V6-4"},
        "project_id": {"$ref": "#/$defs/id"}, "plan_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1},
        "previous_plan_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "blueprint_id": {"$ref": "#/$defs/id"},
        "blueprint_sha256": {"$ref": "#/$defs/sha"},
        "timeline_rate": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}},
        "target_duration_frames": {"type": "integer", "minimum": 1}, "items": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/item"}},
        "timeline_frames_authoritative": {"const": true}, "srt_timing_authoritative": {"const": false},
        "provider_execution_started": {"const": false}, "candidate_mutation_started": {"const": false},
        "task026_compile_started": {"const": false}, "resolve_mutation_started": {"const": false}, "cubase_mutation_started": {"const": false},
        "plan_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
