    "recordReference": {
      "type": "object", "additionalProperties": false,
      "required": ["record_ref", "record_sha256"],
      "properties": {"record_ref": {"$ref": "#/$defs/id"}, "record_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "rationalSampleDuration": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_count", "denominator"],
      "properties": {"sample_count": {"type": "integer", "minimum": 0}, "denominator": {"const": 48000}}
    },
    "halfOpenSampleInterval": {
      "type": "object", "additionalProperties": false,
      "required": ["start_sample", "end_sample"],
      "properties": {"start_sample": {"type": "integer", "minimum": 0}, "end_sample": {"type": "integer", "minimum": 1}}
    },
    "captureChainStage": {
      "type": "object", "additionalProperties": false,
