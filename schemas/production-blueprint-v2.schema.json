{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baisound/bai_video_production/schemas/production-blueprint-v2.schema.json",
  "title": "BAI Production Blueprint v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueprint_version", "blueprint_id", "title", "timeline_rate", "target_duration_frames", "asset_source_priority", "scenes", "blueprint_sha256"],
  "properties": {
    "blueprint_version": {"const": "2.0.0"},
    "blueprint_id": {"type": "string", "pattern": "^BP-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "timeline_rate": {"$ref": "#/$defs/frameRate"},
    "target_duration_frames": {"type": "integer", "minimum": 1},
    "asset_source_priority": {"const": ["REAL_CAPTURE", "REUSE_EXISTING", "COMPOSITE", "AI_GENERATED"]},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "blueprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "frameRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_sha256", "slot_id", "candidate_id"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/identity"},
        "asset_sha256": {"$ref": "#/$defs/checksum"},
        "slot_id": {"$ref": "#/$defs/identity"},
        "candidate_id": {"$ref": "#/$defs/identity"}
      }
    },
    "characterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "asset_id", "asset_sha256", "slot_id", "candidate_id"],
      "properties": {
        "role": {"enum": ["PRIMARY", "SUPPORTING", "BACKGROUND"]},
        "asset_id": {"$ref": "#/$defs/identity"},
        "asset_sha256": {"$ref": "#/$defs/checksum"},
        "slot_id": {"$ref": "#/$defs/identity"},
        "candidate_id": {"$ref": "#/$defs/identity"}
      }
    },
    "frameBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_locks", "space_lock", "composition_lock"],
      "properties": {
        "character_locks": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/characterBinding"}},
        "space_lock": {"oneOf": [{"$ref": "#/$defs/assetBinding"}, {"type": "null"}]},
        "composition_lock": {"oneOf": [{"$ref": "#/$defs/assetBinding"}, {"type": "null"}]}
      }
    },
    "boundedTextList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "frameIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_kind", "visual_intent", "task_axis_target", "required_visible", "forbidden_visible", "depth_order", "camera_semantic", "lens_framing", "binding"],
      "properties": {
        "frame_kind": {"enum": ["START", "END"]},
        "visual_intent": {"type": "string", "minLength": 1, "maxLength": 1024},
        "task_axis_target": {"type": "string", "minLength": 1, "maxLength": 512},
        "required_visible": {"$ref": "#/$defs/boundedTextList"},
        "forbidden_visible": {"$ref": "#/$defs/boundedTextList"},
        "depth_order": {"$ref": "#/$defs/boundedTextList"},
        "camera_semantic": {"type": "string", "minLength": 1, "maxLength": 512},
        "lens_framing": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "binding": {"$ref": "#/$defs/frameBinding"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration", "dialogue", "sound_effects", "bgm", "sound_logo"],
      "properties": {
        "narration": {"type": "boolean"},
        "dialogue": {"type": "boolean"},
        "sound_effects": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "bgm": {"type": "boolean"},
        "sound_logo": {"type": "boolean"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "range_frames", "narrative_role", "source_strategy", "generation_risk", "camera_motion", "start_frame_intent", "end_frame_intent", "audio", "post_composite_text", "final_hold_frames"],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^SC[0-9]{2,3}(-[A-Z])?$"},
        "range_frames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end_exclusive"],
          "properties": {
            "start": {"type": "integer", "minimum": 0},
            "end_exclusive": {"type": "integer", "minimum": 1}
          }
        },
        "narrative_role": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_strategy": {"enum": ["REAL_CAPTURE", "REUSE_EXISTING", "COMPOSITE", "AI_GENERATED"]},
        "generation_risk": {"enum": ["A_LOW_TEXT", "B_HEADLINE", "C_DENSE_UI"]},
        "camera_motion": {"enum": ["STATIC", "SUBTLE", "DYNAMIC"]},
        "start_frame_intent": {"$ref": "#/$defs/frameIntent"},
        "end_frame_intent": {"$ref": "#/$defs/frameIntent"},
        "audio": {"$ref": "#/$defs/audio"},
        "post_composite_text": {"type": "boolean"},
        "final_hold_frames": {"type": "integer", "minimum": 0}
      }
    }
  }
}
