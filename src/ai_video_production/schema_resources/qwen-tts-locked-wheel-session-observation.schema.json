{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/qwen-tts-locked-wheel-session-observation.schema.json",
  "title": "TASK-014 handle-locked pinned wheel session diagnostic receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "package_name", "package_version", "wheel_filename", "wheel_bytes", "wheel_sha256", "trusted_payload_inventory_sha256", "evaluated_at", "decision", "reason_codes", "directory_handles_opened", "wheel_handle_opened", "wheel_bytes_read", "pinned_payload_files", "canonical_paths_verified", "non_reparse_verified", "file_ids_retained_in_session_only", "handles_non_inheritable", "handle_release_confirmed", "unreleased_handle_count", "persistent_receipt_is_capability", "runtime_reuse_authorized", "post_return_state_guaranteed", "consumer_execution_authorized", "dependency_resolved_or_installed", "target_python_executed", "target_package_imported", "model_loaded", "owner_audio_read", "inference_executed", "network_accessed", "subprocess_started", "archive_extracted", "filesystem_modified", "absolute_path_persisted", "receipt_sha256"],
  "properties": {
    "schema": {"const": "bai.task014.qwen-tts-locked-wheel-session-observation.v1"},
    "scope": {"const": "HANDLE_LOCKED_PINNED_WHEEL_READ_SESSION_DIAGNOSTIC_ONLY"},
    "package_name": {"const": "qwen-tts"}, "package_version": {"const": "0.1.1"},
    "wheel_filename": {"const": "qwen_tts-0.1.1-py3-none-any.whl"}, "wheel_bytes": {"const": 113529},
    "wheel_sha256": {"const": "sha256:11a290d8dabc7ef91a90c54478c8ab19b3edb1d85c0882313721892bdc4af15d"},
    "trusted_payload_inventory_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
