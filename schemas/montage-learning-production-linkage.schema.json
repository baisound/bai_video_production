{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.baisound.com/montage-learning-production-linkage.schema.json",
  "title": "TASK-065 Montage Learning Production Linkage",
  "oneOf": [
    { "$ref": "#/$defs/PreactivationChainFixture" },
    { "$ref": "#/$defs/PreactivationFixtureValidation" }
  ],
  "$defs": {
    "OperationId": {
      "type": "string",
      "pattern": "^op_[0-9a-f]{32}$"
    },
    "InstallInstanceId": {
      "type": "string",
      "pattern": "^inst_[0-9a-f]{32}$"
    },
    "RecordId": {
      "type": "string",
      "pattern": "^rec_[0-9a-f]{32}$"
    },
    "ProfileId": {
      "type": "string",
      "pattern": "^prof_[0-9a-f]{32}$"
    },
    "ReceiptId": {
      "type": "string",
      "pattern": "^rcpt_[0-9a-f]{32}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "AdapterStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "record_id",
        "learning_sha256",
        "config_sha256",
        "adapter_build_sha256",
        "invocation_count",
        "status",
        "receipt_sha256"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/OperationId" },
        "record_id": { "$ref": "#/$defs/RecordId" },
        "learning_sha256": { "$ref": "#/$defs/Sha256" },
        "config_sha256": { "$ref": "#/$defs/Sha256" },
        "adapter_build_sha256": { "$ref": "#/$defs/Sha256" },
        "invocation_count": { "const": 1 },
        "status": { "const": "STAGED" },
        "receipt_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Task036Import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "record_id",
        "learning_sha256",
        "invocation_count",
        "status",
        "receipt_sha256"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/OperationId" },
        "record_id": { "$ref": "#/$defs/RecordId" },
        "learning_sha256": { "$ref": "#/$defs/Sha256" },
        "invocation_count": { "const": 1 },
        "status": { "enum": ["ACCEPTED", "DUPLICATE"] },
        "receipt_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "PublicReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "record_id",
        "learning_sha256",
        "status",
        "receipt_sha256",
        "authority_created"
      ],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/ReceiptId" },
        "record_id": { "$ref": "#/$defs/RecordId" },
        "learning_sha256": { "$ref": "#/$defs/Sha256" },
        "status": { "enum": ["ACCEPTED", "DUPLICATE"] },
        "receipt_sha256": { "$ref": "#/$defs/Sha256" },
        "authority_created": { "const": false }
      }
    },
    "HiddenCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "install_instance_id",
        "config_sha256",
        "record_id",
        "learning_sha256",
        "public_receipt_sha256",
        "canonical_readback_sha256",
        "profile_readback_sha256",
        "correlation_sha256"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/OperationId" },
        "install_instance_id": { "$ref": "#/$defs/InstallInstanceId" },
        "config_sha256": { "$ref": "#/$defs/Sha256" },
        "record_id": { "$ref": "#/$defs/RecordId" },
        "learning_sha256": { "$ref": "#/$defs/Sha256" },
        "public_receipt_sha256": { "$ref": "#/$defs/Sha256" },
        "canonical_readback_sha256": { "$ref": "#/$defs/Sha256" },
        "profile_readback_sha256": { "$ref": "#/$defs/Sha256" },
        "correlation_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "CanonicalReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "learning_sha256",
        "canonical_revision",
        "readback_sha256",
        "durable_readback_verified",
        "authority_created"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/RecordId" },
        "learning_sha256": { "$ref": "#/$defs/Sha256" },
        "canonical_revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "readback_sha256": { "$ref": "#/$defs/Sha256" },
        "durable_readback_verified": { "const": true },
        "authority_created": { "const": false }
      }
    },
    "ProfileReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_sha256",
        "source_record_id",
        "source_learning_sha256",
        "readback_sha256",
        "advisory_only",
        "canonical_timeline",
        "auto_apply_authorized",
        "durable_readback_verified",
        "authority_created"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/ProfileId" },
        "profile_sha256": { "$ref": "#/$defs/Sha256" },
        "source_record_id": { "$ref": "#/$defs/RecordId" },
        "source_learning_sha256": { "$ref": "#/$defs/Sha256" },
        "readback_sha256": { "$ref": "#/$defs/Sha256" },
