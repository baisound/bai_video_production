{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/knowledge-pack-signature-artifact-custody-candidate.schema.json",
  "title": "TASK-029 R10C Knowledge Pack Signature Artifact Custody Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version", "record_type", "task_owner", "candidate_id",
    "artifact_store_id", "owner_scope_sha256", "source_key_custody_receipt_sha256",
    "source_signing_ceremony_receipt_sha256", "source_trusted_signature_admission_sha256",
    "pack_id", "pack_version", "predecessor_pack_sha256", "signature_request_sha256",
    "signature_message_sha256", "trusted_signer_policy_sha256", "signer_key_id_sha256",
    "detached_signature_sha256", "verification_receipt_sha256", "created_at_epoch_ms",
    "custody_contract", "state", "r10b_direct_recompile_required_at_write",
    "transient_public_key_required_at_write", "transient_detached_signature_required_at_write",
    "r9b_r9c_r10b_receipts_self_validated", "owner_scope_sourced_from_r9b_receipt",
    "cryptographic_reverification_required_at_write", "owner_local_encrypted_store_required",
    "one_shot_artifact_write_required", "explicit_human_custody_confirmation_required",
    "in_memory_candidate_only", "owner_scope_coordinates_included",
    "project_scope_coordinates_included", "reviewer_coordinates_included",
    "signature_artifact_body_included", "public_key_material_included",
    "private_key_material_included", "absolute_host_path_included", "credential_included",
    "artifact_custody_write_authorized", "signature_artifact_custody_confirmed",
    "source_graph_currentness_confirmed", "owner_scope_origin_authenticated",
    "canonical_receipt_minted", "canonical_trust_root_confirmed",
    "signature_artifact_store_implemented", "storage_security_model_confirmed",
    "directory_durability_confirmed", "hostile_path_race_protection_confirmed",
    "owner_signer_binding_confirmed", "knowledge_pack_write_authorized",
    "knowledge_pack_promotion_authorized", "automatic_promotion_authorized",
    "runtime_profile_apply_authorized", "rollback_execution_authorized",
    "timeline_mutation_authorized", "resolve_mutation_authorized",
    "deploy_authorized", "production_authorized",
    "release_authorized", "external_effect_authorized", "custody_candidate_sha256"
  ],
  "properties": {
    "candidate_version": {"const": "1.0.0"},
    "record_type": {"const": "KNOWLEDGE_PACK_SIGNATURE_ARTIFACT_CUSTODY_CANDIDATE"},
    "task_owner": {"const": "TASK-029"},
    "candidate_id": {"$ref": "#/$defs/stableId"},
    "artifact_store_id": {"$ref": "#/$defs/logicalId"},
    "owner_scope_sha256": {"$ref": "#/$defs/sha256"},
    "source_key_custody_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "source_signing_ceremony_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "source_trusted_signature_admission_sha256": {"$ref": "#/$defs/sha256"},
    "pack_id": {"$ref": "#/$defs/stableId"},
    "pack_version": {"$ref": "#/$defs/semver"},
    "predecessor_pack_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "signature_request_sha256": {"$ref": "#/$defs/sha256"},
    "signature_message_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_signer_policy_sha256": {"$ref": "#/$defs/sha256"},
    "signer_key_id_sha256": {"$ref": "#/$defs/sha256"},
    "detached_signature_sha256": {"$ref": "#/$defs/sha256"},
    "verification_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "created_at_epoch_ms": {"type": "integer", "minimum": 1},
    "custody_contract": {"const": "TASK-029/SIGNATURE_ARTIFACT_CUSTODY/1.0.0"},
    "state": {"const": "READY_FOR_EXPLICIT_HUMAN_CUSTODY_CONFIRMATION"},
    "r9b_r9c_r10b_receipts_self_validated": {"const": true},
    "owner_scope_sourced_from_r9b_receipt": {"const": true},
    "r10b_direct_recompile_required_at_write": {"const": true},
    "transient_public_key_required_at_write": {"const": true},
    "transient_detached_signature_required_at_write": {"const": true},
    "cryptographic_reverification_required_at_write": {"const": true},
    "owner_local_encrypted_store_required": {"const": true},
    "one_shot_artifact_write_required": {"const": true},
    "explicit_human_custody_confirmation_required": {"const": true},
    "in_memory_candidate_only": {"const": true},
    "owner_scope_coordinates_included": {"const": true},
    "project_scope_coordinates_included": {"const": false},
    "reviewer_coordinates_included": {"const": false},
    "signature_artifact_body_included": {"const": false},
    "public_key_material_included": {"const": false},
    "private_key_material_included": {"const": false},
    "absolute_host_path_included": {"const": false},
    "credential_included": {"const": false},
    "artifact_custody_write_authorized": {"const": false},
    "signature_artifact_custody_confirmed": {"const": false},
    "canonical_receipt_minted": {"const": false},
    "source_graph_currentness_confirmed": {"const": false},
    "owner_scope_origin_authenticated": {"const": false},
    "canonical_trust_root_confirmed": {"const": false},
    "owner_signer_binding_confirmed": {"const": false},
    "signature_artifact_store_implemented": {"const": false},
    "storage_security_model_confirmed": {"const": false},
    "directory_durability_confirmed": {"const": false},
    "hostile_path_race_protection_confirmed": {"const": false},
    "knowledge_pack_write_authorized": {"const": false},
    "knowledge_pack_promotion_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "runtime_profile_apply_authorized": {"const": false},
    "rollback_execution_authorized": {"const": false},
    "release_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "timeline_mutation_authorized": {"const": false},
    "resolve_mutation_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_authorized": {"const": false},
    "custody_candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"},
    "logicalId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
  }
}
