{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/montage-learning-connector-activation.schema.json",
  "title": "TASK-061 montage learning connector source binding readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_type", "task_owner", "binding_id", "plan_sha256", "target_install_instance_id", "target_descriptor_sha256", "target_owner_manifest_sha256", "security_attestation_sha256", "migration_snapshot_readback_sha256", "preference_source_readback_sha256", "preference_envelope_sha256", "task058_public_readiness_sha256", "task058_public_readiness_version", "task058_public_v1_source_not_bound_baseline_validated", "private_v2_persistent_receipt_accepted", "profile_id", "profile_version", "profile_sha256", "profile_publish_status", "state", "production_profile_source_bound", "profile_view_readback_verified", "real_adapter_e2e_verified", "connector_config_modified", "connector_enabled", "activation_authorized", "learning_adoption_authorized", "automatic_promotion_authorized", "timeline_mutation_authorized", "resolve_write_authorized", "external_effect_authorized", "binding_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "message_type": {"const": "BvpMontageLearningConnectorSourceBindingReadiness"},
    "task_owner": {"const": "TASK-061"},
    "binding_id": {"type": "string", "pattern": "^source-binding-[0-9a-f]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/sha"},
    "target_install_instance_id": {"type": "string", "pattern": "^bvp-install-[0-9a-f]{32}$"},
    "target_descriptor_sha256": {"$ref": "#/$defs/sha"},
    "target_owner_manifest_sha256": {"$ref": "#/$defs/sha"},
    "security_attestation_sha256": {"$ref": "#/$defs/sha"},
    "migration_snapshot_readback_sha256": {"$ref": "#/$defs/sha"},
    "preference_source_readback_sha256": {"$ref": "#/$defs/sha"},
    "preference_envelope_sha256": {"$ref": "#/$defs/sha"},
    "task058_public_readiness_sha256": {"$ref": "#/$defs/sha"},
    "task058_public_readiness_version": {"const": "1.0.0"},
    "task058_public_v1_source_not_bound_baseline_validated": {"const": true},
    "private_v2_persistent_receipt_accepted": {"const": false},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "integer", "minimum": 1},
    "profile_sha256": {"$ref": "#/$defs/sha"},
    "profile_publish_status": {"const": "CURRENT_EXACT_PROFILE"},
    "state": {"const": "SOURCE_BOUND_ACTIVATION_BLOCKED"},
    "production_profile_source_bound": {"const": true},
    "profile_view_readback_verified": {"const": true},
    "real_adapter_e2e_verified": {"const": false},
    "connector_config_modified": {"const": false},
    "connector_enabled": {"const": false},
    "activation_authorized": {"const": false},
    "learning_adoption_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "timeline_mutation_authorized": {"const": false},
    "resolve_write_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "binding_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
