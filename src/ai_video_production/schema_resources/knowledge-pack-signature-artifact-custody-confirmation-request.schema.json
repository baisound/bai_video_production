{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/knowledge-pack-signature-artifact-custody-confirmation-request.schema.json",
  "title": "TASK-029 R10E Signature Artifact Custody Confirmation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version", "record_type", "task_owner", "request_id",
    "custody_receipt_id", "custody_receipt_sha256", "candidate_sha256",
    "artifact_store_id", "owner_scope_sha256", "source_key_custody_receipt_sha256",
    "source_signing_ceremony_receipt_sha256", "source_trusted_signature_admission_sha256",
    "pack_id", "pack_version", "predecessor_pack_sha256", "signature_request_sha256",
    "signature_message_sha256", "trusted_signer_policy_sha256", "signer_key_id_sha256",
    "detached_signature_sha256", "verification_receipt_sha256", "intent_attestation_sha256",
    "staged_at_epoch_ms", "requested_at_epoch_ms", "expires_at_epoch_ms",
    "source_custody_contract", "confirmation_request_contract", "state", "path_security_model",
    "source_receipt_self_hash_required_by_compiler", "source_receipt_self_hash_revalidated",
    "source_receipt_publicly_constructible",
    "production_dpapi_receipt_claim_required", "encrypted_staging_body_read",
    "post_write_storage_reverified", "human_interaction_channel_required",
    "trusted_human_confirmation_required", "body_free_request",
    "signature_artifact_body_included", "public_key_material_included",
    "private_key_material_included", "absolute_host_path_included", "credential_included",
    "standalone_request_authoritative", "source_store_origin_authenticated",
    "production_dpapi_storage_origin_authenticated", "trusted_clock_verified",
    "request_currently_fresh_verified", "trusted_human_confirmation_received",
    "human_confirmation_origin_authenticated", "one_shot_confirmation_enforced",
    "custody_promotion_authorized", "staging_delete_authorized", "owner_local_path_verified",
    "canonical_store_path_binding_confirmed", "canonical_custody_write_authorized",
    "canonical_custody_receipt_minted", "canonical_trust_root_confirmed",
    "owner_signer_binding_confirmed", "canonical_knowledge_pack_receipt_minted",
    "knowledge_pack_write_authorized", "knowledge_pack_promotion_authorized",
    "automatic_promotion_authorized", "runtime_profile_apply_authorized",
    "rollback_execution_authorized", "timeline_mutation_authorized",
    "resolve_mutation_authorized", "release_authorized", "deploy_authorized",
    "production_authorized", "external_effect_authorized", "confirmation_request_sha256"
  ],
  "properties": {
    "request_version": {"const": "1.0.0"},
    "record_type": {"const": "SIGNATURE_ARTIFACT_CUSTODY_CONFIRMATION_REQUEST"},
    "task_owner": {"const": "TASK-029"},
    "request_id": {"$ref": "#/$defs/logicalId"},
    "custody_receipt_id": {"$ref": "#/$defs/logicalId"},
    "custody_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_store_id": {"$ref": "#/$defs/logicalId"},
    "owner_scope_sha256": {"$ref": "#/$defs/sha256"},
    "source_key_custody_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "source_signing_ceremony_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "source_trusted_signature_admission_sha256": {"$ref": "#/$defs/sha256"},
    "pack_id": {"$ref": "#/$defs/packId"},
    "pack_version": {"$ref": "#/$defs/semver"},
    "predecessor_pack_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "signature_request_sha256": {"$ref": "#/$defs/sha256"},
    "signature_message_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_signer_policy_sha256": {"$ref": "#/$defs/sha256"},
    "signer_key_id_sha256": {"$ref": "#/$defs/sha256"},
    "detached_signature_sha256": {"$ref": "#/$defs/sha256"},
    "verification_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "intent_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "staged_at_epoch_ms": {"type": "integer", "minimum": 1},
    "requested_at_epoch_ms": {"type": "integer", "minimum": 1},
    "expires_at_epoch_ms": {"type": "integer", "minimum": 1},
    "source_custody_contract": {"const": "TASK-029/SIGNATURE_ARTIFACT_CUSTODY_STORE/1.0.0"},
    "confirmation_request_contract": {"const": "TASK-029/SIGNATURE_ARTIFACT_CUSTODY_CONFIRMATION_REQUEST/1.0.0"},
    "state": {"const": "AWAITING_TRUSTED_HUMAN_CUSTODY_CONFIRMATION"},
    "path_security_model": {"const": "COOPERATIVE_PROTECTED_LOCAL_WRITER_ONLY"},
    "source_receipt_self_hash_required_by_compiler": {"const": true},
    "source_receipt_self_hash_revalidated": {"const": false},
    "source_receipt_publicly_constructible": {"const": true},
    "production_dpapi_receipt_claim_required": {"const": true},
    "encrypted_staging_body_read": {"const": false},
    "post_write_storage_reverified": {"const": false},
    "human_interaction_channel_required": {"const": true},
    "trusted_human_confirmation_required": {"const": true},
    "body_free_request": {"const": true},
    "signature_artifact_body_included": {"const": false},
    "public_key_material_included": {"const": false},
    "private_key_material_included": {"const": false},
    "absolute_host_path_included": {"const": false},
    "credential_included": {"const": false},
    "standalone_request_authoritative": {"const": false},
    "source_store_origin_authenticated": {"const": false},
    "production_dpapi_storage_origin_authenticated": {"const": false},
    "trusted_clock_verified": {"const": false},
    "request_currently_fresh_verified": {"const": false},
    "trusted_human_confirmation_received": {"const": false},
    "human_confirmation_origin_authenticated": {"const": false},
    "one_shot_confirmation_enforced": {"const": false},
    "custody_promotion_authorized": {"const": false},
    "staging_delete_authorized": {"const": false},
    "owner_local_path_verified": {"const": false},
    "canonical_store_path_binding_confirmed": {"const": false},
    "canonical_custody_write_authorized": {"const": false},
    "canonical_custody_receipt_minted": {"const": false},
    "canonical_trust_root_confirmed": {"const": false},
    "owner_signer_binding_confirmed": {"const": false},
    "canonical_knowledge_pack_receipt_minted": {"const": false},
    "knowledge_pack_write_authorized": {"const": false},
    "knowledge_pack_promotion_authorized": {"const": false},
    "automatic_promotion_authorized": {"const": false},
    "runtime_profile_apply_authorized": {"const": false},
    "rollback_execution_authorized": {"const": false},
    "timeline_mutation_authorized": {"const": false},
    "resolve_mutation_authorized": {"const": false},
    "release_authorized": {"const": false},
    "deploy_authorized": {"const": false},
    "production_authorized": {"const": false},
    "external_effect_authorized": {"const": false},
    "confirmation_request_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"},
    "packId": {
      "allOf": [
        {"$ref": "#/$defs/stableId"},
        {"not": {"pattern": "^[A-Za-z]:[/\\\\]"}},
        {"not": {"pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"}}
      ]
    },
    "logicalId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
  }
}
