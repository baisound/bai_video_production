{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.local/schemas/dbd-reasoning-dataset-leakage-report.schema.json",
  "title": "DbD Reasoning Dataset Leakage Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "rights_manifest_sha256",
    "audited_segments_sha256",
    "segment_count",
    "split_count",
    "findings",
    "status",
    "audit_state",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "DBD_REASONING_DATASET_LEAKAGE_REPORT"},
    "rights_manifest_sha256": {"$ref": "#/$defs/sha"},
    "audited_segments_sha256": {"$ref": "#/$defs/sha"},
    "segment_count": {"type": "integer", "minimum": 1, "maximum": 2048},
    "split_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "findings": {
      "type": "array",
      "maxItems": 8192,
      "items": {"$ref": "#/$defs/finding"}
    },
    "status": {"enum": ["PASS", "FAIL", "NOT_CONFIRMED"]},
    "audit_state": {"const": "EVIDENCE_ONLY_NO_ADOPTION"},
    "report_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "segmentId": {
      "type": "string",
      "pattern": "^SEG-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "split": {
      "enum": ["TRAIN", "VALIDATION", "TEST"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left_segment_id",
        "right_segment_id",
        "left_split",
        "right_split",
        "fingerprint_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SOURCE_GROUP_SPLIT",
            "MATCH_SPLIT",
            "EXACT_TRANSCRIPT_DUPLICATE",
            "PHRASE_OVERLAP"
          ]
        },
        "left_segment_id": {"$ref": "#/$defs/segmentId"},
        "right_segment_id": {"$ref": "#/$defs/segmentId"},
        "left_split": {"$ref": "#/$defs/split"},
        "right_split": {"$ref": "#/$defs/split"},
        "fingerprint_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
