      "then": {"properties": {"receipts": {"properties": {"quick_clone": {"type": "object", "properties": {"producer_state": {"const": "REJECTED"}}}, "listening_join": {"type": "object", "properties": {"producer_state": {"const": "REJECTED"}}}}}}}
