        "settings_sha256", "processing_state", "phantom_power_observation_state",
        "pad_observation_state", "hpf_observation_state", "preamp_gain_observation_state",
        "hidden_processing_state", "gain_role",
        "previous_stage_sha256", "next_stage_sha256", "evidence_ref", "evidence_sha256",
        "stable_private_ref", "stable_private_ref_sha256", "observed_display_name",
