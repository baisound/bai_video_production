    "quickClone": {"allOf": [{"$ref": "#/$defs/receiptBase"}, {"properties": {"owner_task":{"const":"TASK-046"},"receipt_type":{"const":"QUICK_CLONE_FLOW_READBACK_V2"},"schema_version":{"const":2},"producer_state":{"enum":["ACTIVE","RETEST_REQUIRED","ACCEPTED","REJECTED","BLOCKED","UNKNOWN"]},"operation_plan_sha256":{"const":null},"quick_clone_flow_sha256":{"$ref":"#/$defs/digest"},"expires_at":{"const":null}}}, {"if":{"properties":{"producer_state":{"const":"ACTIVE"}}},"then":{"$ref":"#/$defs/candidateNull"}}, {"if":{"properties":{"producer_state":{"enum":["RETEST_REQUIRED","ACCEPTED","REJECTED"]}}},"then":{"$ref":"#/$defs/candidateRequired"}}]},
