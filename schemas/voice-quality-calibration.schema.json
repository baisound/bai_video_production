    "task003AssetBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_state", "asset_id", "asset_checksum_sha256", "asset_record_evidence_sha256", "asset_revision_binding_ref", "asset_revision_binding_sha256", "official_mapping_state"],
      "properties": {
        "contract_state": {"$ref": "#/$defs/contractState"},
