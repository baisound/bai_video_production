{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.github.io/bai-video-production/schemas/montage-learning-bridge-migration.schema.json",
  "title": "TASK-061 Montage Learning Bridge migration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_type", "task_owner", "migration_id", "plan_sha256", "source_root_identity_sha256", "source_tree_sha256", "target_install_instance_id", "target_descriptor_sha256", "target_owner_manifest_sha256", "security_attestation_sha256", "final_security_attestation_sha256", "file_count", "directory_count", "total_bytes", "state", "unknown_files_preserved", "source_deleted", "source_modified", "active_bridge_view_modified", "profile_admitted", "learning_adopted", "connector_config_modified", "activation_authorized", "timeline_mutated", "resolve_written", "external_effect_authorized", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "message_type": {"const": "BvpMontageLearningBridgeMigrationReceipt"},
    "task_owner": {"const": "TASK-061"},
    "migration_id": {"type": "string", "pattern": "^migration-[0-9a-f]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/sha"},
    "source_root_identity_sha256": {"$ref": "#/$defs/sha"},
    "source_tree_sha256": {"$ref": "#/$defs/sha"},
    "target_install_instance_id": {"type": "string", "pattern": "^bvp-install-[0-9a-f]{32}$"},
    "target_descriptor_sha256": {"$ref": "#/$defs/sha"},
    "target_owner_manifest_sha256": {"$ref": "#/$defs/sha"},
    "security_attestation_sha256": {"$ref": "#/$defs/sha"},
    "final_security_attestation_sha256": {"$ref": "#/$defs/sha"},
    "file_count": {"type": "integer", "minimum": 0, "maximum": 1024},
    "directory_count": {"type": "integer", "minimum": 0, "maximum": 1024},
    "total_bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
    "state": {"const": "READBACK_VERIFIED"},
    "unknown_files_preserved": {"const": true},
    "source_deleted": {"const": false},
    "source_modified": {"const": false},
    "active_bridge_view_modified": {"const": false},
    "profile_admitted": {"const": false},
    "learning_adopted": {"const": false},
    "connector_config_modified": {"const": false},
    "activation_authorized": {"const": false},
    "timeline_mutated": {"const": false},
    "resolve_written": {"const": false},
    "external_effect_authorized": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
