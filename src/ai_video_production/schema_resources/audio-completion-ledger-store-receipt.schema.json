        ,{"if": {"properties": {"rename_state": {"const": "RETURNED_FALSE"}}, "required": ["rename_state"]}, "then": {"properties": {"decision": {"const": "INCOMPLETE"}, "commit_state": {"const": "NOT_COMMITTED"}}}}
        ,{"if": {"properties": {"commit_state": {"const": "COMMIT_STATE_UNKNOWN"}}, "required": ["commit_state"]}, "then": {"properties": {"decision": {"const": "COMMIT_STATE_UNKNOWN"}, "rename_state": {"const": "SYSCALL_COMPLETION_UNKNOWN"}}}}
        ,{"if": {"properties": {"decision": {"enum": ["APPENDED", "ALREADY_COMMITTED_RECONCILED"]}}, "required": ["decision"]}, "then": {"properties": {"stored_entry_sha256": {"$ref": "#/$defs/digest"}, "expected_cas_sha256": {"$ref": "#/$defs/digest"}, "entry_count": {"minimum": 1}}}}
