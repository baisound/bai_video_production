{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bai:task047:obs-plugin-package-manifest:v1",
  "title": "BAI OBS Plugin Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "version", "kind", "target", "license", "file_count", "files"],
  "properties": {
    "schema": {"const": "BAI_OBS_PLUGIN_PACKAGE_MANIFEST_V1"},
    "module": {"const": "bai-voice-capture"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "kind": {"enum": ["SOURCE", "RUNTIME"]},
    "target": {"const": "windows-x64-obs-32.2.1"},
    "license": {"const": "GPL-2.0-or-later"},
    "file_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\\\].*"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
