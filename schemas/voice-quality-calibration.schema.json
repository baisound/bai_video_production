        "pad_observation_state": {"enum": ["DECLARED", "MEASURED", "OBSERVED", "UNKNOWN", "NOT_APPLICABLE"]},
        "hpf_observation_state": {"enum": ["DECLARED", "MEASURED", "OBSERVED", "UNKNOWN", "NOT_APPLICABLE"]},
        "preamp_gain_observation_state": {"enum": ["DECLARED", "MEASURED", "OBSERVED", "UNKNOWN", "NOT_APPLICABLE"]},
        "hidden_processing_state": {"enum": ["CLEAR", "DETECTED", "UNKNOWN"]},
