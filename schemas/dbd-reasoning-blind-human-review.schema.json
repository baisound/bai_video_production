{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.local/schemas/dbd-reasoning-blind-human-review.schema.json",
  "title": "DbD Reasoning Blind Human Review Evidence",
  "oneOf": [
    {"$ref": "#/$defs/presentation"},
    {"$ref": "#/$defs/reveal"},
    {"$ref": "#/$defs/submission"},
    {"$ref": "#/$defs/authorityBinding"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "packRef": {"type": "string", "pattern": "^blind-review-pack://sha256/[0-9a-f]{64}$"},
    "sampleRef": {"type": "string", "pattern": "^eval-sample://sha256/[0-9a-f]{64}$"},
    "reviewerRef": {"type": "string", "pattern": "^reviewer://sha256/[0-9a-f]{64}$"},
    "confirmationRef": {"type": "string", "pattern": "^human-confirmation://dbd-blind-review/[0-9A-HJKMNP-TV-Z]{26}$"},
    "authorityEvidenceRef": {"type": "string", "pattern": "^human-evidence://dbd-blind-review/sha256/[0-9a-f]{64}$"},
    "label": {"enum": ["A", "B", "C"]},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "candidate_output_sha256"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "candidate_output_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "presentationSample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_ref", "candidates"],
      "properties": {
        "sample_ref": {"$ref": "#/$defs/sampleRef"},
        "candidates": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"label": {"const": "A"}}}]},
            {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"label": {"const": "B"}}}]},
            {"allOf": [{"$ref": "#/$defs/candidate"}, {"properties": {"label": {"const": "C"}}}]}
          ],
          "items": false
        }
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "arm", "binding_sha256", "output_evidence_set_sha256", "candidate_output_sha256"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "arm": {"enum": ["BASELINE", "GENERIC", "TUNED"]},
        "binding_sha256": {"$ref": "#/$defs/sha"},
        "output_evidence_set_sha256": {"$ref": "#/$defs/sha"},
        "candidate_output_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "revealSample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_ref", "mappings"],
      "properties": {
        "sample_ref": {"$ref": "#/$defs/sampleRef"},
        "mappings": {
          "type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/mapping"}
        }
      }
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "candidate_output_sha256", "factual_acceptable", "uncertainty_handling", "usefulness", "timing", "naturalness", "density"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "candidate_output_sha256": {"$ref": "#/$defs/sha"},
        "factual_acceptable": {"type": "boolean"},
        "uncertainty_handling": {"type": "integer", "minimum": 1, "maximum": 5},
        "usefulness": {"type": "integer", "minimum": 1, "maximum": 5},
        "timing": {"type": "integer", "minimum": 1, "maximum": 5},
        "naturalness": {"type": "integer", "minimum": 1, "maximum": 5},
        "density": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "reasonCodes": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {"enum": ["ALL_CANDIDATES_UNACCEPTABLE", "DENSITY_POOR", "FACTUAL_ERROR", "NOT_USEFUL", "OTHER_REVIEW_REASON", "TIMING_POOR", "UNCERTAINTY_POOR", "UNNATURAL"]}
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_kind", "offline_evaluation_report_sha256", "test_sample_set_sha256", "pack_ref", "samples", "presentation_state", "presentation_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_kind": {"const": "DBD_REASONING_BLIND_REVIEW_PRESENTATION"},
        "offline_evaluation_report_sha256": {"$ref": "#/$defs/sha"},
        "test_sample_set_sha256": {"$ref": "#/$defs/sha"},
        "pack_ref": {"$ref": "#/$defs/packRef"},
        "samples": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/presentationSample"}},
        "presentation_state": {"const": "BLIND_PRESENTATION_NO_IDENTITY_REVEAL"},
        "presentation_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "reveal": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_kind", "offline_evaluation_report_sha256", "presentation_sha256", "pack_ref", "samples", "reveal_state", "reveal_manifest_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_kind": {"const": "DBD_REASONING_BLIND_REVIEW_REVEAL_MANIFEST"},
        "offline_evaluation_report_sha256": {"$ref": "#/$defs/sha"},
        "presentation_sha256": {"$ref": "#/$defs/sha"},
        "pack_ref": {"$ref": "#/$defs/packRef"},
        "samples": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/revealSample"}},
        "reveal_state": {"const": "SEALED_UNTIL_SUBMISSIONS_ADMITTED"},
        "reveal_manifest_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_kind", "offline_evaluation_report_sha256", "presentation_sha256", "pack_ref", "sample_ref", "reviewer_ref", "scores", "preference", "reason_codes", "reviewer_kind", "confirmation_ref", "confirmation_sha256", "one_shot", "reviewed_at", "submission_state", "submission_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_kind": {"const": "DBD_REASONING_BLIND_HUMAN_REVIEW_SUBMISSION"},
        "offline_evaluation_report_sha256": {"$ref": "#/$defs/sha"},
        "presentation_sha256": {"$ref": "#/$defs/sha"},
        "pack_ref": {"$ref": "#/$defs/packRef"},
        "sample_ref": {"$ref": "#/$defs/sampleRef"},
        "reviewer_ref": {"$ref": "#/$defs/reviewerRef"},
        "scores": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/score"}, {"properties": {"label": {"const": "A"}}}]},
            {"allOf": [{"$ref": "#/$defs/score"}, {"properties": {"label": {"const": "B"}}}]},
            {"allOf": [{"$ref": "#/$defs/score"}, {"properties": {"label": {"const": "C"}}}]}
          ],
          "items": false
        },
        "preference": {"enum": ["A", "B", "C", "ALL_REJECTED"]},
        "reason_codes": {"$ref": "#/$defs/reasonCodes"},
        "reviewer_kind": {"const": "HUMAN"},
        "confirmation_ref": {"$ref": "#/$defs/confirmationRef"},
        "confirmation_sha256": {"$ref": "#/$defs/sha"},
        "one_shot": {"const": true},
        "reviewed_at": {"type": "string", "format": "date-time", "maxLength": 40},
        "submission_state": {"const": "BLIND_HUMAN_EVIDENCE_NO_PROMOTION"},
        "submission_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "authorityBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_kind", "presentation_sha256", "pack_ref", "sample_ref", "reviewer_ref", "expected_submission_sha256", "confirmation_ref", "confirmation_revision", "confirmation_sha256", "authority_evidence_ref", "authority_evidence_sha256", "reviewer_kind", "decided_at", "expires_at", "one_shot", "binding_state", "binding_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_kind": {"const": "DBD_REASONING_BLIND_HUMAN_REVIEW_AUTHORITY_BINDING"},
        "presentation_sha256": {"$ref": "#/$defs/sha"},
        "pack_ref": {"$ref": "#/$defs/packRef"},
        "sample_ref": {"$ref": "#/$defs/sampleRef"},
        "reviewer_ref": {"$ref": "#/$defs/reviewerRef"},
        "expected_submission_sha256": {"$ref": "#/$defs/sha"},
        "confirmation_ref": {"$ref": "#/$defs/confirmationRef"},
        "confirmation_revision": {"type": "integer", "minimum": 1},
        "confirmation_sha256": {"$ref": "#/$defs/sha"},
        "authority_evidence_ref": {"$ref": "#/$defs/authorityEvidenceRef"},
        "authority_evidence_sha256": {"$ref": "#/$defs/sha"},
        "reviewer_kind": {"const": "HUMAN"},
        "decided_at": {"type": "string", "format": "date-time", "maxLength": 40},
        "expires_at": {"type": "string", "format": "date-time", "maxLength": 40},
        "one_shot": {"const": true},
        "binding_state": {"const": "EXTERNAL_HUMAN_AUTHORITY_BOUND"},
        "binding_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
